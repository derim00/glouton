+void drawBlobAndCo(Band& b) {
+  float cx = camX(), cy = camY();
+  KDColor body = baseColor();
+  bool glow = s.biome == Biome::Night || s.biome == Biome::Disco;
+  // Minis
+  for (int i = 0; i < s.numberOfMinis; i++) {
+    const Mini& m = s.minis[i];
+    float x = m.x - cx, y = m.y - cy;
+    float rx = 8 * (1 + m.squash * 0.6f), ry = 8 * (1 - m.squash * 0.6f);
+    float yy = y + (8 - ry) * (s.flipped ? -1 : 1);
+    ellipse(b, x, yy, rx + 1.5f, ry + 1.5f, mix(body, rgb(0x0B0B1A), 170));
+    ellipse(b, x, yy, rx, ry, body);
+    ellipse(b, x - rx * 0.35f, yy - ry * 0.45f, rx * 0.3f, ry * 0.2f, rgb(0xFFFFFF), 170);
+    float look = s.blob.x() > m.x ? 1.f : -1.f;
+    for (int e = -1; e <= 1; e += 2) {
+      ellipse(b, x + e * 3.f, yy - 1.5f, 2.2f, 2.6f, rgb(0xFFFFFF));
+      ellipse(b, x + e * 3.f + look * 0.8f, yy - 1.2f, 1.2f, 1.4f, rgb(0x14101E));
+    }
+  }
+  if (s.popping) {
+    return;
+  }
+  // Tongue (behind the body)
+  float mx, my;
+  mouth(&mx, &my);
+  if (s.eat == EatPhase::TongueOut || s.eat == EatPhase::TongueBack) {
+    float t = (s.now - s.eatStart) / (s.eat == EatPhase::TongueOut ? 130.f : 170.f);
+    t = t > 1 ? 1 : t;
+    float k = s.eat == EatPhase::TongueOut ? t : 1 - t;
+    float tx = mx + (s.eatToX - mx) * k, ty = my + (s.eatToY - my) * k;
+    line(b, mx - cx, my - cy, tx - cx, ty - cy, 7, rgb(0x8A1B3E));
+    line(b, mx - cx, my - cy, tx - cx, ty - cy, 4.5f, rgb(0xFF6F96));
+    ellipse(b, tx - cx, ty - cy, 5, 5, rgb(0xFF6F96));
+    if (s.eat == EatPhase::TongueBack) {
+      if (s.meal == Meal::Item) {
+        drawCandy(b, tx - cx, ty - cy, s.eatIndex, 0.85f, 256, false);
+      } else if (s.meal == Meal::Pellet) {
+        drawPellet(b, tx - cx, ty - cy, s.eaten.text, 256, false);
+      }
+    }
+  }
+  if (s.eat == EatPhase::Fly) {
+    float t = (s.now - s.eatStart) / 380.f;
+    t = t > 1 ? 1 : t;
+    float e = t * t;
+    float x = s.eatFromX + (mx - s.eatFromX) * e, y = s.eatFromY + (my - s.eatFromY) * e;
+    drawCandy(b, x - cx, y - cy - sinf(t * k_pi) * 40, s.eatIndex, 1.f - 0.3f * t,
+              256, false);
+  }
+  int alpha = s.ghost ? 95 : 236;
+  s.blob.render(b, cx, cy, body, alpha, glow);
+  float bx = s.blob.x() - cx, by = s.blob.y() - cy;
+  float hw = s.blob.halfWidth(), hh = s.blob.halfHeight();
+  // What it is digesting, seen through the jelly
+  if (s.eat == EatPhase::Chew || s.eat == EatPhase::Burp) {
+    float t = (s.now - s.eatStart) / 680.f;
+    t = s.eat == EatPhase::Burp ? 1 : (t > 1 ? 1 : t);
+    float sc = 0.75f - 0.45f * t;
+    if (s.meal == Meal::Item) {
+      drawCandy(b, bx, by + hh * 0.2f, s.eatIndex, sc, 150, false);
+    } else {
+      drawPellet(b, bx, by + hh * 0.25f, s.eaten.text, 150 - static_cast<int>(100 * t),
+                 false);
+    }
+  }
+  // Gloss
+  ellipse(b, bx - hw * 0.42f, by - hh * 0.48f, hw * 0.26f, hh * 0.15f, rgb(0xFFFFFF),
+          s.ghost ? 80 : 190);
+  ellipse(b, bx - hw * 0.1f, by - hh * 0.66f, hw * 0.07f, hh * 0.05f, rgb(0xFFFFFF),
+          s.ghost ? 80 : 200);
+  // Where it looks
+  float lx = s.facing * 0.6f, ly = 0;
+  if (s.targetKind == 1) {
+    lx = (s_items[s.targetIndex].x - s.blob.x()) / 80.f;
+    ly = (s_items[s.targetIndex].y - s.blob.y()) / 80.f;
+  } else if (s.targetKind == 2) {
+    lx = (s.pellets[s.targetIndex].x - s.blob.x()) / 80.f;
+    ly = (s.pellets[s.targetIndex].y - s.blob.y()) / 80.f;
+  }
+  lx = lx < -1 ? -1 : (lx > 1 ? 1 : lx);
+  ly = ly < -1 ? -1 : (ly > 1 ? 1 : ly);
+  drawFace(b, bx, by, hw, hh, currentFace(), mix(body, rgb(0xFFFFFF), 40), lx, ly);
+  drawHats(b, bx, s.blob.top() - cy, hw);
+}
+
+void drawParticles(Band& b) {
+  float cx = camX(), cy = camY();
+  const Rect& clip = b.clip();
+  for (const Particle& p : s.particles) {
+    if (p.life == 0) {
+      continue;
+    }
+    int x = static_cast<int>(p.x - cx), y = static_cast<int>(p.y - cy);
+    if (y < clip.y - 20 || y > clip.bottom() + 20 || x < -20 || x > k_screenWidth + 20) {
+      continue;
+    }
+    int a = p.life * 256 / p.maxLife;
+    a = a > 200 ? 256 : a + 56;
+    switch (p.kind) {
+      case PKind::Confetti:
+      case PKind::Crumb:
+        fill(b, {x, y, p.size, p.size}, p.color(), a);
+        break;
+      case PKind::Spark:
+        fill(b, {x - p.size, y, 2 * p.size + 1, 1}, p.color(), a);
+        fill(b, {x, y - p.size, 1, 2 * p.size + 1}, p.color(), a);
+        break;
+      case PKind::Zzz:
+        text(b, p.life > p.maxLife / 2 ? "z" : "Z", x, y, p.color(), Small, Align::Left,
+             k_screenWidth, a);
+        break;
+      case PKind::Bubble:
+        arc(b, x, y, p.size, 1.f, 0, p.color(), a * 3 / 4);
+        fill(b, {x - p.size / 2, y - p.size / 2, 1, 1}, rgb(0xFFFFFF), a);
+        break;
+      case PKind::Ember:
+        ellipse(b, x, y, p.size + 0.5f, p.size + 0.5f, p.color(), a);
+        break;
+      case PKind::Heart:
+        heart(b, x - 4, y - 4, 1, p.color(), a);
+        break;
+      case PKind::Note:
+        ellipse(b, x, y, 3, 2.2f, p.color(), a);
+        line(b, x + 2.5f, y, x + 2.5f, y - 9, 1.2f, p.color(), a);
+        line(b, x + 2.5f, y - 9, x + 6, y - 6, 1.2f, p.color(), a);
+        break;
+      case PKind::Drop:
+        ellipse(b, x, y, p.size + 1.2f, p.size + 1.2f, mix(p.color(), rgb(0x0B0B1A), 170));
+        ellipse(b, x, y, p.size, p.size, p.color());
+        ellipse(b, x - p.size * 0.3f, y - p.size * 0.4f, p.size * 0.3f, p.size * 0.25f,
+                rgb(0xFFFFFF), 180);
+        break;
+      case PKind::Steam:
+      case PKind::Dust: {
+        float grow = 1 + (1 - p.life / static_cast<float>(p.maxLife)) * 1.5f;
+        ellipse(b, x, y, p.size * grow, p.size * grow * 0.8f, p.color(), a / 3);
+        break;
+      }
+      case PKind::Firefly: {
+        int g = static_cast<int>(130 + 120 * sinf(s.now * 0.006f + p.maxLife));
+        ellipse(b, x, y, 4, 4, p.color(), g / 4);
+        ellipse(b, x, y, 1.3f, 1.3f, p.color(), g);
+        break;
+      }
+    }
+  }
+}
+
+void drawBubble(Band& b) {
+  if (s.message.text[0] == 0 || s.mode != Mode::World) {
+    return;
+  }
+  // Split the lines
+  const char* lines[3];
+  int lens[3];
+  int n = 0;
+  const char* p = s.message.text;
+  while (n < 3) {
+    const char* e = strchr(p, '\n');
+    lines[n] = p;
+    lens[n] = e ? static_cast<int>(e - p) : static_cast<int>(strlen(p));
+    n++;
+    if (!e) {
+      break;
+    }
+    p = e + 1;
+  }
+  char buf[3][60];
+  int w = 0;
+  for (int i = 0; i < n; i++) {
+    int l = lens[i] < 59 ? lens[i] : 59;
+    memcpy(buf[i], lines[i], l);
+    buf[i][l] = 0;
+    int tw = textWidth(buf[i]);
+    w = tw > w ? tw : w;
+  }
+  int lh = glyphHeight();
+  int bw = w + 14, bh = n * lh + 8;
+  float bx = s.blob.x() - camX(), top = s.blob.top() - camY();
+  bool below = top - bh - 14 < 2 || s.flipped;
+  int x = static_cast<int>(bx) - bw / 2;
+  x = clampi(x, 3, k_screenWidth - bw - 3);
+  int y = below ? static_cast<int>(s.blob.bottom() - camY()) + 12
+                : static_cast<int>(top) - bh - 12;
+  if (s.costume != 0 && !below) {
+    y -= 14;
+  }
+  y = clampi(y, 2, k_screenHeight - bh - 2);
+  // Pop-in
+  uint32_t age = s.now - s.messageStart;
+  int alpha = age < 120 ? static_cast<int>(age * 256 / 120) : 256;
+  Rect r = {x, y, bw, bh};
+  KDColor ink = rgb(0x1A1030);
+  roundFill(b, {r.x + 2, r.y + 3, r.w, r.h}, 8, rgb(0x000000), alpha / 4);
+  roundFill(b, r, 8, rgb(0xFFFFFF), alpha);
+  roundFrame(b, r, 8, ink, alpha);
+  float tx = clampi(static_cast<int>(bx), x + 10, x + bw - 10);
+  float tipY = below ? y - 7 : y + bh + 7;
+  float baseY = below ? y + 1 : y + bh - 1;
+  float xs[3] = {tx - 6, tx + 6, tx + (below ? 0 : -2)};
+  float ys[3] = {baseY, baseY, tipY};
+  polygon(b, xs, ys, 3, ink, alpha);
+  float xs2[3] = {tx - 4, tx + 4, tx + (below ? 0 : -1.5f)};
+  float ys2[3] = {baseY + (below ? 1 : -1), baseY + (below ? 1 : -1),
+                  tipY + (below ? 2 : -2)};
+  polygon(b, xs2, ys2, 3, rgb(0xFFFFFF), alpha);
+  for (int i = 0; i < n; i++) {
+    text(b, buf[i], x + bw / 2, y + 4 + i * lh, ink, Small, Align::Center,
+         k_screenWidth, alpha);
+  }
+}
