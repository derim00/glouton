+
+void dust(float x, float y, int n) {
+  for (int i = 0; i < n; i++) {
+    float dir = (i % 2) ? 1.f : -1.f;
+    spawn(PKind::Dust, x, y, dir * (40 + frnd() * 80), -10 - frnd() * 30,
+          450, rgb(0xFFFFFF), 3 + rnd() % 3);
