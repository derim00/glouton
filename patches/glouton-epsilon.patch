+
+/* ================================================== LED and backlight */
+
+int heartbeat() {
+  // Two beats per second-ish: lub-dub
+  uint32_t period = s.hunger > 75 || s.now < s.angryUntil ? 600 : 1100;
+  uint32_t t = s.now % period;
+  float k = 0;
+  if (t < 120) {
+    k = 1.f - t / 120.f;
+  } else if (t >= 220 && t < 340) {
+    k = 0.7f * (1.f - (t - 220) / 120.f);
+  }
+  return static_cast<int>(k * 255);
+}
+
+void setLed(KDColor c) {
+  if (!s.ledSet || static_cast<uint16_t>(c) != s.ledLast) {
+    Ion::LED::setColor(c);
+    s.ledLast = static_cast<uint16_t>(c);
+    s.ledSet = true;
+  }
+}
+
+void restoreLed() {
+  if (s.ledSet) {
+    Ion::LED::updateColorWithPlugAndCharge();
+    s.ledSet = false;
+  }
+}
+
+void updateLed() {
+  if (!s.ledOn || examMode() || !s_attached) {
+    restoreLed();
+    return;
+  }
+  KDColor c;
+  int k;
+  if (s.mode == Mode::Boot && s.now - s.modeStart < 3600) {
+    c = rgb(0xFFF2D0);
+    k = heartbeat() * (s.now - s.modeStart) / 3600;
+  } else if (s.sleeping) {
+    c = baseColor();
+    k = static_cast<int>(25 + 25 * sinf(s.now * 0.0015f));
+  } else if (s.now < s.angryUntil || s.now < s.evilUntil) {
+    c = rgb(0xFF0000);
+    k = (s.now / 120) % 2 ? 255 : 30;
+  } else if (s.biome == Biome::Disco || s.now < s.danceUntil ||
+             s.now < s.evolveStart + 2200) {
+    c = hsv((s.now / 4) % 360, 255, 255);
+    k = 200;
+  } else if (s.now < s.flashUntil) {
+    c = rgb(0xFFFFFF);
+    k = 255;
+  } else if (s.ghost) {
+    c = rgb(0xBFD8FF);
+    k = 20;
+  } else {
+    c = baseColor();
+    k = 25 + heartbeat() * 3 / 5;
+  }
+  setLed(KDColor::RGB888(c.red() * k / 255, c.green() * k / 255,
+                         c.blue() * k / 255));
+}
+
+void updateBacklight() {
+  int target = s.userBrightness;
+  if (s.lightOn && !examMode()) {
+    if (s.sleeping) {
+      target = s.userBrightness / 3;
+      if (target < 12) {
+        target = 12;
+      }
+    }
+    if (s.now < s.flashUntil) {
+      target = Ion::Backlight::MaxBrightness;
+    }
+  }
+  if (target != s.brightness) {
+    s.brightness = target;
+    if (!s_fake) {
+      Ion::Backlight::setBrightness(target);
+    }
+  }
+}
+
+void flash(int ms) { s.flashUntil = s.now + ms; }
