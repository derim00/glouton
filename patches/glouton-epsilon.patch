+void drawEgg(Band& b, float cx, float cy, float angle, int cracks) {
+  float rx = 20, ry = 26;
+  Rect z = Rect{static_cast<int>(cx - 34), static_cast<int>(cy - 34), 68, 68}
+               .intersection(b.clip());
+  float cs = cosf(angle), sn = sinf(angle);
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    for (int x = z.x; x < z.right(); x++) {
+      float dx = x + 0.5f - cx, dy = y + 0.5f - cy;
+      float u = cs * dx + sn * dy, v = -sn * dx + cs * dy;
+      // Egg: narrower at the top
+      float rxx = rx * (v < 0 ? 0.85f + 0.15f * (1 + v / ry) : 1.f);
+      float d = (u * u) / (rxx * rxx) + (v * v) / (ry * ry);
+      if (d > 1.08f) {
+        continue;
+      }
+      KDColor c;
+      if (d > 0.9f) {
+        c = rgb(0x6B4A2B);
+      } else {
+        float shade = 0.5f + 0.35f * (u / rx) + 0.3f * (v / ry);
+        c = mix(rgb(0xFFF6E0), rgb(0xD9C49A), static_cast<int>(shade * 200));
+        uint32_t h = hash((static_cast<int>(u + 40) / 5) * 97 + static_cast<int>(v + 40) / 5);
+        if (h % 9 == 0) {
+          c = mix(c, rgb(0x7CC46F), 150);
+        }
+      }
+      row[x] = c;
+    }
+  }
+  // Cracks
+  static constexpr float k_crack[3][8] = {
+      {-14, -6, -8, 0, -2, -7, 4, -1},
+      {2, -16, 6, -9, 2, -3, 8, 3},
+      {-6, 6, 0, 12, 6, 5, 12, 10}};
+  for (int c = 0; c < cracks && c < 3; c++) {
+    for (int k = 0; k < 3; k++) {
+      float u0 = k_crack[c][2 * k], v0 = k_crack[c][2 * k + 1];
+      float u1 = k_crack[c][2 * k + 2], v1 = k_crack[c][2 * k + 3];
+      line(b, cx + cs * u0 - sn * v0, cy + sn * u0 + cs * v0, cx + cs * u1 - sn * v1,
+           cy + sn * u1 + cs * v1, 1.6f, rgb(0x3A2614));
+    }
+  }
+}
+
+void renderBoot(Band& b) {
+  uint32_t t = s.now - s.modeStart;
+  if (t >= 3600) {
+    renderWorld(b);
+  } else {
+    drawSky(b);
+    drawGround(b);
+    drawDecor(b);
+    float wob = 0;
+    if (t > 600) {
+      float k = (t - 600) / 3000.f;
+      float freq = 0.012f + k * 0.02f;
+      wob = sinf(t * freq) * (0.05f + 0.3f * k) * ((t / 700) % 2 ? 1 : 0.3f);
+    }
+    int cracks = t > 3200 ? 3 : (t > 2500 ? 2 : (t > 1600 ? 1 : 0));
+    ellipse(b, 160 - camX(), k_floorY + 1, 22, 4, rgb(0x000000), 70);
+    drawEgg(b, 160 - camX(), k_floorY - 25, wob, cracks);
+    if (t > 1000 && t < 3400) {
+      const char* toc = (t / 500) % 2 ? "toc..." : "toc toc";
+      text(b, toc, 196 - static_cast<int>(camX()), 150, rgb(0xFFFFFF), Small);
+    }
+    drawParticles(b);
+  }
+  // Title
+  if (t > 4200) {
+    static constexpr char k_title[] = "GLOUTON";
+    int n = 7;
+    int letterW = 24;
+    int x0 = k_screenWidth / 2 - n * letterW / 2;
+    for (int i = 0; i < n; i++) {
+      int lt = static_cast<int>(t) - 4200 - i * 90;
+      if (lt < 0) {
+        continue;
+      }
+      float drop = lt < 400 ? (1 - lt / 400.f) : 0;
+      float bounce = lt < 700 ? fabsf(sinf(lt * 0.012f)) * (1 - lt / 700.f) * 10 : 0;
+      int y = 36 - static_cast<int>(drop * drop * 80 + bounce) +
+              static_cast<int>(2 * sinf(s.now * 0.004f + i));
+      char c[2] = {k_title[i], 0};
+      KDColor col = hsv(100 + i * 12, 200, 250);
+      bigText(b, c, x0 + i * letterW + 2, y + 3, 3, rgb(0x0B2A14));
+      bigText(b, c, x0 + i * letterW, y, 3, col);
+    }
+  }
+  if (t > 5200) {
+    int a = t > 5600 ? 256 : static_cast<int>((t - 5200) * 256 / 400);
+    outlinedText(b, "ta calculatrice a faim.", k_screenWidth / 2, 98, rgb(0xFFFFFF),
+                 Small, Align::Center);
+    (void)a;
+  }
+  if (t < 400) {
+    fill(b, b.clip(), rgb(0x000000), 256 - static_cast<int>(t * 256 / 400));
+  }
+  if (t >= 3600 && t < 3900) {
+    fill(b, b.clip(), rgb(0xFFFFFF), 256 - static_cast<int>((t - 3600) * 256 / 300));
+  }
+}
+
+void updateBoot(float dt) {
+  uint32_t t = s.now - s.modeStart;
+  if (t >= 3600 && !s.initialized) {
+    return;
+  }
+  static bool hatched = false;
+  if (t < 3600) {
+    hatched = false;
+    s.camX = 0;
+    // The egg is warm: it beats
+    if ((t / 900) != ((t - static_cast<uint32_t>(dt * 1000)) / 900) && t > 600) {
+      shake(1.5f, 120);
+    }
+  } else if (!hatched) {
+    hatched = true;
+    s.blob.init(160, k_floorY - 30, k_stageRadius[0]);
+    s.blob.impulse(0, -260);
+    for (int i = 0; i < 14; i++) {
+      float a = frnd() * k_pi + k_pi;
+      spawn(PKind::Crumb, 160, k_floorY - 26, cosf(a) * 160, sinf(a) * 200, 1500,
+            rgb(0xFFF6E0), 3 + rnd() % 3);
+    }
+    confetti(160, k_floorY - 40, 30);
+    shake(5, 400);
+    flash(150);
+  }
+  if (t >= 3600) {
+    Control c = {0, false, false, false};
+    if (t > 4800 && (t / 600) != ((t - static_cast<uint32_t>(dt * 1000)) / 600)) {
+      c.jump = true;  // happy little hops
+    }
+    s.blob.step(dt, environment(), c);
+    s.blob.takeImpact();
+  }
+  updateParticles(dt);
+}
