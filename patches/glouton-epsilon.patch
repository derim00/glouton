+/* ================================================================ meals */
+
+void gainXp(int n) {
+  s.xp += n;
+  int st = stageFor(s.xp);
+  if (st > s.stage) {
+    s.stage = st;
+    s.evolveStart = s.now;
+    s.blob.setRadius(k_stageRadius[st]);
+    flash(160);
+    shake(4, 500);
+    confetti(s.blob.x(), s.blob.y(), 40);
+    if (st >= 2 && !s.discoUnlocked) {
+      s.discoUnlocked = true;
+    }
+  }
+}
+
+void eaten() {
+  if (s.numberOfBites > 0) {
+    // Feeding heals the screen it nibbled
+    s.numberOfBites--;
+  }
+  s.hunger -= s.meal == Meal::Pellet ? 24.f : 12.f;
+  if (s.hunger < 0) {
+    s.hunger = 0;
+  }
+}
+
+void startPop() {
+  s.popping = true;
+  s.popStart = s.now;
+  s.inflation = 1.f;
+  s.blob.setInflation(1.f);
+  KDColor c = baseColor();
+  for (int i = 0; i < 18; i++) {
+    float a = 2 * k_pi * i / 18 + frnd() * 0.3f;
+    float v = 160 + frnd() * 160;
+    spawn(PKind::Drop, s.blob.x(), s.blob.y(), cosf(a) * v,
+          sinf(a) * v - 80, 1500, c, 4 + rnd() % 4);
+  }
+  confetti(s.blob.x(), s.blob.y(), 16);
+  shake(7, 600);
+  flash(140);
+  say("*POP*", Face::Dizzy, 1500);
+}
+
+/* What GLOUTON thinks of the result you fed it */
+void react(const Pellet& p) {
+  char line[100];
+  Str m(line, sizeof(line));
+  double v = 0;
+  bool number = parseNumber(p.output, &v);
+  s.numbersEaten++;
+  s.weight += 3 * static_cast<int>(strlen(p.output)) + 2;
+  strlcpy(s.lastMeal, p.output, sizeof(s.lastMeal));
+  gainXp(1);
+  KDColor here = rgb(0xFFE08A);
+  float x = s.blob.x(), y = s.blob.y();
+  bool nonNumber = !number;
+  if (nonNumber && (contains(p.output, "undef") || contains(p.output, "nonreal"))) {
+    s.sickUntil = s.now + 12000;
+    for (int i = 0; i < 10; i++) {
+      spawn(PKind::Bubble, x + (frnd() - 0.5f) * 30, y, (frnd() - 0.5f) * 20,
+            -30 - frnd() * 30, 1400, rgb(0x9BD34A), 3 + rnd() % 3);
+    }
+    say("BEURK ! Du \"undef\"...\nJ'ai mal au ventre.",
+        Face::Sick, 4000);
+    return;
+  }
+  if (nonNumber && contains(p.output, "inf")) {
+    s.inflation = 1.95f;
+    s.blob.setInflation(s.inflation);
+    s.hugeUntil = s.now + 900;
+    say("L'INFINI ?!\nC'est trop pour moi !!!", Face::Wow, 2000);
+    return;
+  }
+  if (nonNumber) {
+    say("C'est quoi ce truc ?!\n\xC3\x87""a croustille bizarre.", Face::Dizzy,
+        3500);
+    crumbs(x, y, 10, here);
+    return;
+  }
+  if (strcmp(p.input, "1+1") == 0) {
+    say("Tu avais VRAIMENT besoin\nde moi pour 1+1 ?", Face::Angry, 4000);
+    return;
+  }
+  double a = v < 0 ? -v : v;
+  bool integer = a < 1e15 && v == static_cast<double>(static_cast<long long>(v));
+  long long iv = integer ? static_cast<long long>(v) : 0;
+  if (integer && iv == 42) {
+    sparkles(x, y, 20, rgb(0xFFF07A));
+    say("42 ! La r\xC3\xA9ponse \xC3\xA0 tout.\nJe me sens sage.", Face::Love,
+        4000);
+  } else if (fabs(v - 3.14159265) < 2e-5) {
+    s.partyUntil = s.now + 5000;
+    confetti(x, y, 40);
+    say("DU \xCF\x80 !!! MON PLAT\nPR\xC3\x89""F\xC3\x89R\xC3\x89 !!!",
+        Face::Love, 4000);
+  } else if (integer && iv == 666) {
+    s.evilUntil = s.now + 9000;
+    shake(3, 900);
+    say("666... je me sens\nbizarre. H\xC3\x89H\xC3\x89H\xC3\x89.", Face::Evil,
+        4500);
+  } else if (integer && iv == 69) {
+    say("Nice.", Face::Joy, 2500);
+  } else if (integer && iv == 1337) {
+    s.tanned = true;
+    s.costume = 4;
+    say("1337 ! Je suis un\nhacker maintenant.", Face::Joy, 4000);
+  } else if (integer && iv == 404) {
+    say("404 : nombre introuvable.\nAh si, je l'ai mang\xC3\xA9.", Face::Joy,
+        4000);
+  } else if (integer && iv == 0) {
+    say("Z\xC3\xA9ro. C'est vide.\nJ'ai encore faim.", Face::Hungry, 3500);
+  } else if (integer && iv == 7) {
+    sparkles(x, y, 12, rgb(0x7AF0FF));
+    say("7 ! Mon chiffre\nporte-bonheur.", Face::Love, 3500);
+  } else if (integer && iv == 1) {
+    say("Un. Tout seul.\nComme moi avant toi.", Face::Happy, 3500);
+  } else if (a >= 1e9) {
+    s.inflation = 1.45f;
+    s.blob.setInflation(s.inflation);
+    s.hugeUntil = s.now + 6000;
+    s.weight += 500;
+    say("\xC3\x89NORME ! +500 g.\nJe vais exploser... *burp*", Face::Wow,
+        4000);
+  } else if (v < 0) {
+    setFace(Face::Angry, 1500);
+    s.blob.jiggle(120, rnd());
+    m.add(p.text).add(" ? N\xC3\xA9gatif...\n\xC3\x87""a pique, c'est acide !");
+    say(line, Face::Angry, 3500);
+  } else if (integer && iv >= 2 && iv < 100000000) {
+    bool prime = true;
+    for (long long d = 2; d * d <= iv; d++) {
+      if (iv % d == 0) {
+        prime = false;
+        break;
+      }
+    }
+    if (prime) {
+      m.add(p.text).add(" est premier !\nCroquant comme tout.");
+      sparkles(x, y, 10, rgb(0xB0FF7A));
+    } else {
+      m.add("Miam, un ").add(p.text).add(" !\nBien rond, bien bon.");
+    }
+    say(line, Face::Joy, 3500);
+  } else {
+    m.add(p.text).add("... plein de\nvirgules, \xC3\xA7""a colle aux dents.");
+    say(line, Face::Happy, 3500);
+  }
+  crumbs(x, y, 8, here);
+}
+
+void spawnPellet(const char* input, const char* output, float x) {
+  Pellet* slot = nullptr;
+  for (Pellet& p : s.pellets) {
+    if (!p.active) {
+      slot = &p;
+      break;
+    }
+  }
+  if (!slot) {
+    slot = &s.pellets[rnd() % k_maxPellets];
+  }
+  slot->active = true;
+  slot->x = x;
+  slot->y = s.flipped ? k_floorY + 10 : -10;
+  slot->vx = (frnd() - 0.5f) * 60;
+  slot->vy = 0;
+  strlcpy(slot->input, input, sizeof(slot->input));
+  strlcpy(slot->output, output, sizeof(slot->output));
+  // The label: at most 9 characters (UTF-8 aware)
+  int n = 0, chars = 0;
+  while (output[n] && chars < 9) {
+    n++;
+    while ((static_cast<uint8_t>(output[n]) & 0xC0) == 0x80) {
+      n++;
+    }
+    chars++;
+  }
+  int len = n < static_cast<int>(sizeof(slot->text)) - 4 ? n : 0;
+  memcpy(slot->text, output, len);
+  slot->text[len] = 0;
+  if (output[n]) {
+    strlcpy(slot->text + len, "..", sizeof(slot->text) - len);
+  }
+}
+
+// Results of the Calculation app that GLOUTON has not eaten yet rain down
+int collectFood() {
+  uint32_t produced = Food::produced();
+  int n = 0;
+  if (s.foodSeen + k_maxPellets < produced) {
+    s.foodSeen = produced - k_maxPellets;
+  }
+  while (s.foodSeen < produced) {
+    const Food::Entry* e = Food::at(s.foodSeen);
+    s.foodSeen++;
+    if (e) {
+      // The first one falls right on GLOUTON, the others around
+      float x = n == 0 ? s.blob.x() : s.blob.x() + (n % 2 ? 1 : -1) * (24 + 22 * n);
+      if (x < 20) {
+        x = 20 + 25 * n;
+      }
+      if (x > s.worldWidth - 20) {
+        x = s.worldWidth - 20 - 25 * n;
+      }
+      spawnPellet(e->input, e->output, x);
+      n++;
+    }
+  }
+  return n;
+}
+
+/* ============================================================== eating */
+
+void startEat(Meal meal, int index, float toX, float toY) {
+  s.meal = meal;
+  s.eatIndex = index;
+  s.eatToX = toX;
+  s.eatToY = toY;
+  s.eat = EatPhase::TongueOut;
+  s.eatStart = s.now;
+  s.sleeping = false;
+}
+
+void tongue() {
+  if (s.eat != EatPhase::None || s.popping) {
+    return;
+  }
+  float mx, my;
+  mouth(&mx, &my);
+  if (s.targetKind == 1) {
+    int i = s.targetIndex;
+    startEat(Meal::Item, i, s_items[i].x, s_items[i].y + itemBob(i));
+  } else if (s.targetKind == 2) {
+    Pellet& p = s.pellets[s.targetIndex];
+    startEat(Meal::Pellet, s.targetIndex, p.x, p.y);
+  } else {
+    startEat(Meal::Nothing, 0, mx + s.facing * 110, my - 20);
+  }
+}
+
+void eatFromFridge(int i) {
+  s.mode = Mode::World;
+  s.meal = Meal::Item;
+  s.eatIndex = i;
+  s.eat = EatPhase::Fly;
+  s.eatStart = s.now;
+  s.eatFromX = s.camX + 160;
+  s.eatFromY = -20;
+  s.sleeping = false;
+}
+
+void digest();
+
+void updateEating() {
+  uint32_t t = s.now - s.eatStart;
+  switch (s.eat) {
+    case EatPhase::None:
+      return;
+    case EatPhase::TongueOut:
+      if (s.meal == Meal::Pellet) {
+        // The pellet may still be falling: follow it
+        Pellet& p = s.pellets[s.eatIndex];
+        if (p.active) {
+          s.eatToX = p.x;
+          s.eatToY = p.y;
+        }
+      }
+      if (t >= 130) {
+        s.eat = EatPhase::TongueBack;
+        s.eatStart = s.now;
+        if (s.meal == Meal::Pellet) {
+          Pellet& p = s.pellets[s.eatIndex];
+          s.eaten = p;
+          p.active = false;
+          if (!s.eaten.active) {
+            s.meal = Meal::Nothing;
+          }
+        } else if (s.meal == Meal::Item) {
+          s.goneItem = s.eatIndex;
+        }
+      }
+      return;
+    case EatPhase::TongueBack:
+    case EatPhase::Fly:
+      if (t >= (s.eat == EatPhase::Fly ? 380u : 170u)) {
+        if (s.meal == Meal::Nothing) {
+          s.eat = EatPhase::None;
+          if (rnd() % 2) {
+            say("Rien \xC3\xA0 manger par l\xC3\xA0...", Face::Hungry, 1800);
+          }
+          return;
+        }
+        if (s.meal == Meal::Item) {
+          s.goneItem = s.eatIndex;
+        }
+        s.eat = EatPhase::Chew;
+        s.eatStart = s.now;
+        s.blob.squeeze(3.f);
+      }
+      return;
+    case EatPhase::Chew: {
+      // Chomp chomp chomp
+      uint32_t before = (t - (s.now - s.last)) / 170;
+      if (t / 170 != before && t > 0) {
+        s.blob.squeeze((t / 170) % 2 ? 2.2f : -2.2f);
+        float mx, my;
+        mouth(&mx, &my);
+        crumbs(mx, my, 3,
+               s.meal == Meal::Item ? itemColor(s.eatIndex) : rgb(0xF4D9A0));
+      }
+      if (t >= 680) {
+        eaten();
+        if (s.meal == Meal::Pellet) {
+          s.eat = EatPhase::None;
+          react(s.eaten);
+        } else {
+          s.eat = EatPhase::Burp;
+          s.eatStart = s.now;
+          s.appsEaten++;
+          s.appMeals[s.eatIndex]++;
+          s.weight += 40;
+          s.tint = static_cast<uint16_t>(itemColor(s.eatIndex));
+          s.tintUntil = s.now + 9000;
+          gainXp(1);
+          s.blob.squeeze(-3.f);
+          say("BUUUURP !", Face::Joy, 900);
+        }
+      }
+      return;
+    }
+    case EatPhase::Burp:
+      if (t >= 420) {
+        s.eat = EatPhase::None;
+        digest();
+      }
+      return;
+  }
+}
+
+/* ================================================================ minis */
+
+void updateMinis(float dt, const Env& env) {
+  float down = env.gravity >= 0 ? 1.f : -1.f;
+  float g = fabsf(env.gravity);
+  for (int i = 0; i < s.numberOfMinis; i++) {
+    Mini& m = s.minis[i];
+    // They follow the big one, in a line
+    float tx = s.blob.x() - s.facing * (s.blob.halfWidth() + 14 + 18 * i);
+    m.vx += (tx - m.x) * 6.f * dt;
+    m.vx *= 1.f - 3.f * dt;
+    m.vy += down * g * dt;
+    m.x += m.vx * dt;
+    m.y += m.vy * dt;
+    float r = 7.f;
+    bool landed = false;
+    if (down > 0 && m.y > k_floorY - r) {
+      m.y = k_floorY - r;
+      landed = m.vy > 60;
+      m.vy = 0;
+    } else if (down < 0 && m.y < k_ceilY + r) {
+      m.y = k_ceilY + r;
+      landed = m.vy < -60;
+      m.vy = 0;
+    }
+    if (landed) {
+      m.squash = 0.45f;
+    }
+    bool onGround = (down > 0 && m.y >= k_floorY - r - 0.5f) ||
+                    (down < 0 && m.y <= k_ceilY + r + 0.5f);
+    // Hop with the big one, or for fun
+    if (onGround && ((!s.blob.grounded() && fabsf(m.x - s.blob.x()) < 120 &&
+                      (rnd() % 8) == 0) ||
+                     (rnd() % 160) == 0)) {
+      m.vy = -down * sqrtf(2 * g * (30 + 20 * frnd()));
+      m.squash = -0.35f;
+    }
+    m.squash += (0 - m.squash) * (10.f * dt > 1 ? 1 : 10.f * dt);
+    m.phase += dt;
+    if (m.x < 8) {
+      m.x = 8;
+    } else if (m.x > s.worldWidth - 8) {
+      m.x = s.worldWidth - 8;
+    }
+  }
+}
+
+/* =============================================================== world */
+
+void updateParticles(float dt) {
+  int ms = static_cast<int>(dt * 1000);
+  for (Particle& p : s.particles) {
+    if (p.life == 0) {
+      continue;
+    }
+    p.life = p.life > ms ? p.life - ms : 0;
+    switch (p.kind) {
+      case PKind::Confetti:
+      case PKind::Crumb:
+        p.vy += 420 * dt;
+        p.vx *= 1 - 1.5f * dt;
+        if (p.y > k_floorY && p.vy > 0) {
+          p.y = k_floorY;
+          p.vy *= -0.3f;
+          p.vx *= 0.5f;
+        }
+        break;
+      case PKind::Drop:
+        if (s.popping && s.now - s.popStart > 850) {
+          // Back together
+          p.vx += (s.blob.x() - p.x) * 30 * dt;
+          p.vy += (s.blob.y() - p.y) * 30 * dt;
+          p.vx *= 1 - 5 * dt;
+          p.vy *= 1 - 5 * dt;
+        } else {
+          p.vy += 600 * dt;
+          if (p.y > k_floorY - 2 && p.vy > 0) {
+            p.y = k_floorY - 2;
+            p.vy *= -0.35f;
+            p.vx *= 0.6f;
+          }
+        }
+        break;
+      case PKind::Zzz:
+      case PKind::Note:
+      case PKind::Bubble:
+      case PKind::Ember:
+      case PKind::Steam:
+        p.vx += sinf((s.now + p.maxLife * 7) * 0.006f) * 40 * dt;
+        break;
+      case PKind::Firefly:
+        p.vx += (frnd() - 0.5f) * 200 * dt;
+        p.vy += (frnd() - 0.5f) * 200 * dt;
+        p.vx *= 1 - dt;
+        p.vy *= 1 - dt;
+        break;
+      case PKind::Dust:
+        p.vx *= 1 - 4 * dt;
+        p.vy *= 1 - 4 * dt;
+        break;
+      default:
+        p.vx *= 1 - 2 * dt;
+        p.vy *= 1 - 2 * dt;
+        break;
+    }
+    p.x += p.vx * dt;
+    p.y += p.vy * dt;
+  }
+}
+
+void ambient(float dt) {
+  // Biome life
+  float chance = dt * 1000;
+  float left = s.camX, w = k_screenWidth;
+  switch (s.biome) {
+    case Biome::Night:
+      if (rnd() % 1000 < chance * 0.06f) {
+        spawn(PKind::Firefly, left + frnd() * w, 60 + frnd() * 130, 0, 0,
+              4000, rgb(0xE8FF7A), 2);
+      }
+      break;
+    case Biome::Volcano:
+      if (rnd() % 1000 < chance * 0.25f) {
+        spawn(PKind::Ember, left + frnd() * w, k_floorY,
+              (frnd() - 0.5f) * 20, -30 - frnd() * 60, 2500,
+              hsv(10 + rnd() % 35, 255, 255), 1 + rnd() % 2);
+      }
+      break;
+    case Biome::Aquarium:
+      if (rnd() % 1000 < chance * 0.12f) {
+        spawn(PKind::Bubble, left + frnd() * w, k_floorY, 0,
+              -25 - frnd() * 30, 6000, rgb(0xBFEFFF), 2 + rnd() % 3);
+      }
+      break;
+    case Biome::Disco:
+      if (rnd() % 1000 < chance * 0.08f) {
+        spawn(PKind::Spark, left + frnd() * w, 20 + frnd() * 150, 0, 8,
+              700, hsv(rnd() % 360, 200, 255), 2);
+      }
+      break;
+    default:
+      break;
+  }
+}
+
+void chooseTarget() {
+  s.targetKind = 0;
+  if (s.eat != EatPhase::None || s.popping) {
+    return;
+  }
+  float mx, my;
+  mouth(&mx, &my);
+  float best = k_tongueRange;
+  for (int i = 0; i < k_maxPellets; i++) {
+    const Pellet& p = s.pellets[i];
+    if (!p.active) {
+      continue;
+    }
+    float d = hypotf(p.x - mx, p.y - my) * 0.8f;  // food first
+    if (d < best) {
+      best = d;
+      s.targetKind = 2;
+      s.targetIndex = i;
+    }
+  }
+  for (int i = 0; i < s_numberOfItems; i++) {
+    if (i == s.goneItem) {
+      continue;
+    }
+    float dx = s_items[i].x - mx, dy = s_items[i].y - my;
+    float d = hypotf(dx, dy);
+    if (dx * s.facing < -8) {
+      d += 50;  // behind
+    }
+    if (d < best) {
+      best = d;
+      s.targetKind = 1;
+      s.targetIndex = i;
+    }
+  }
+}
+
+void updatePellets(float dt, const Env& env) {
+  float down = env.gravity >= 0 ? 1.f : -1.f;
+  for (int i = 0; i < k_maxPellets; i++) {
+    Pellet& p = s.pellets[i];
+    if (!p.active) {
+      continue;
+    }
+    if (s.eat == EatPhase::TongueOut && s.meal == Meal::Pellet &&
+        s.eatIndex == i) {
+      continue;
+    }
+    p.vy += down * fabsf(env.gravity) * 0.7f * dt;
+    p.x += p.vx * dt;
+    p.y += p.vy * dt;
+    if (down > 0 && p.y > k_floorY - 8) {
+      p.y = k_floorY - 8;
+      p.vy = p.vy > 80 ? -p.vy * 0.4f : 0;
+      p.vx *= 0.8f;
+    } else if (down < 0 && p.y < k_ceilY + 8) {
+      p.y = k_ceilY + 8;
+      p.vy = p.vy < -80 ? -p.vy * 0.4f : 0;
+      p.vx *= 0.8f;
+    }
+    if (p.x < 12) {
+      p.x = 12;
+      p.vx = -p.vx;
+    } else if (p.x > s.worldWidth - 12) {
+      p.x = s.worldWidth - 12;
+      p.vx = -p.vx;
+    }
+    // Touching GLOUTON: gulp
+    if (s.eat == EatPhase::None && !s.popping &&
+        fabsf(p.x - s.blob.x()) < s.blob.halfWidth() + 6 &&
+        fabsf(p.y - s.blob.y()) < s.blob.halfHeight() + 6) {
+      s.eaten = p;
+      p.active = false;
+      s.meal = Meal::Pellet;
+      s.eat = EatPhase::Chew;
+      s.eatStart = s.now;
+    }
+  }
+}
+
+void idleLife(Control* c) {
+  uint32_t idle = s.now - s.lastInput;
+  if (s.sleeping) {
+    if ((s.now / 900) != ((s.now - 40) / 900)) {
+      spawn(PKind::Zzz, s.blob.x() + s.blob.halfWidth() * 0.6f,
+            s.blob.top() - 4, 12, -22, 2400, rgb(0xFFFFFF), 1);
+    }
+    return;
+  }
+  if (idle > 35000 && s.eat == EatPhase::None && !s.popping &&
+      s.now > s.danceUntil && s.biome != Biome::Disco) {
+    s.sleeping = true;
+    say("Bon... je fais une\npetite sieste. zZz", Face::Sleep, 2500);
+    return;
+  }
+  if (s.biome == Biome::Disco && s.blob.grounded() && idle > 1500 &&
+      (s.now / 460) != ((s.now - 40) / 460)) {
+    // It cannot help dancing
+    c->jump = true;
+  }
+  if (idle > 9000 && s.now > s.nextIdle) {
+    s.nextIdle = s.now + 5000 + rnd() % 5000;
+    int what = rnd() % 4;
+    if (what == 0) {
+      c->jump = true;
+    } else if (what == 1 && s.targetKind == 1) {
+      const AppInfo* info = s_items[s.targetIndex].info;
+      say(info ? info->sniff : "Un jeu ! \xC3\x87""a sent\nle fun.",
+          Face::Happy, 3000);
+    } else if (what == 2) {
+      say(k_idleLines[rnd() % count(k_idleLines)], Face::Happy, 3500);
+    } else {
+      s.facing = -s.facing;
+      for (int i = 0; i < 3; i++) {
+        spawn(PKind::Note, s.blob.x(), s.blob.top(), (frnd() - 0.5f) * 40,
+              -40, 1500, rgb(0xFFFFFF), 1);
+      }
+    }
+  }
+  if (idle > 2000 && idle < 9000 && (rnd() % 400) == 0) {
+    // Looks the other way, now and then
+    s.facing = -s.facing;
+  }
+}
+
+void hungerLife(float dt) {
+  s.hunger += dt * (100.f / (18 * 60));  // empty to starving: 18 minutes
+  if (s.hunger > 100) {
+    s.hunger = 100;
+  }
+  if (s.hunger > 75 && s.now > s.nextHungry && !s.sleeping &&
+      s.mode == Mode::World && s.eat == EatPhase::None) {
+    s.nextHungry = s.now + 25000;
+    queue(k_hungryLines[rnd() % count(k_hungryLines)], Face::Hungry, 3500);
+    shake(2, 400);
+  }
+  if (s.hunger >= 95 && s.now > s.nextBite && s.numberOfBites < k_maxBites &&
+      s.mode == Mode::World) {
+    // So hungry it eats the screen
+    s.nextBite = s.now + 15000;
+    Bite& b = s.bites[s.numberOfBites++];
+    int side = rnd() % 4;
+    b.r = 14 + rnd() % 16;
+    if (side == 0) {
+      b.x = rnd() % k_screenWidth;
+      b.y = 0;
+    } else if (side == 1) {
+      b.x = rnd() % k_screenWidth;
+      b.y = k_screenHeight;
+    } else {
+      b.x = side == 2 ? 0 : k_screenWidth;
+      b.y = 30 + rnd() % 180;
+    }
+    say("J'ai tellement faim que\nje mange ton \xC3\xA9""cran.", Face::Hungry,
+        4000);
+    shake(3, 300);
+  }
+}
+
+void updateWorld(float dt, const Ion::Keyboard::State& keys) {
+  Control c = {0, false, false, false};
+  bool busy = s.eat == EatPhase::TongueOut || s.eat == EatPhase::TongueBack ||
+              s.eat == EatPhase::Burp || s.popping;
+  if (!busy && !s.sleeping && s.mode == Mode::World) {
+    if (keys.keyDown(Key::Left)) {
+      c.move = -1;
+    } else if (keys.keyDown(Key::Right)) {
+      c.move = 1;
+    }
+    c.jumpHeld = keys.keyDown(Key::Up) || keys.keyDown(Key::EXE);
+  }
+  c.jump = s.jumpRequest && !busy;
+  c.slam = s.slamRequest && !busy;
+  s.jumpRequest = s.slamRequest = false;
+  if (c.move != 0) {
+    s.facing = c.move > 0 ? 1 : -1;
+    s.lastInput = s.now;
+  }
+  if (s.now < s.danceUntil && !busy) {
+    float t = (s.danceUntil - s.now) * 0.004f;
+    c.move = sinf(t * 2.f) * 0.9f;
+    c.jumpHeld = true;
+    if (s.blob.grounded() && (rnd() % 5) == 0) {
+      c.jump = true;
+    }
+    if ((rnd() % 6) == 0) {
+      spawn(PKind::Note, s.blob.x(), s.blob.top(), (frnd() - 0.5f) * 60,
+            -50, 1300, hsv(rnd() % 360, 160, 255), 1);
+    }
+  }
+  idleLife(&c);
+  Env env = environment();
+  // Volcano: the floor burns
+  if (s.biome == Biome::Volcano && s.blob.grounded() &&
+      s.blob.bottom() > k_floorY - 1 && !s.flipped) {
+    if (s.hotSince == 0) {
+      s.hotSince = s.now;
+    } else if (s.now - s.hotSince > 1400) {
+      s.hotSince = 0;
+      c.jump = true;
+      c.jumpHeld = true;
+      for (int i = 0; i < 4; i++) {
+        spawn(PKind::Steam, s.blob.x() + (frnd() - 0.5f) * 20,
+              s.blob.bottom(), 0, -40, 900, rgb(0xFFFFFF), 4);
+      }
+      if ((rnd() % 3) == 0) {
+        say("A\xC3\x8F""E ! \xC3\x87""a br\xC3\xBBle !", Face::Wow, 1200);
+      }
+    }
+  } else {
+    s.hotSince = 0;
+  }
+  // Inflation relaxes by itself
+  if (s.now > s.hugeUntil && s.inflation > 1.f && !s.popping) {
+    s.inflation += (1.f - s.inflation) * (dt * 0.25f);
+    s.blob.setInflation(s.inflation);
+  }
+  if (s.hugeUntil && s.now > s.hugeUntil && s.inflation > 1.85f) {
+    s.hugeUntil = 0;
+    startPop();
+  }
+  if (s.popping) {
+    if (s.now - s.popStart > 1350) {
+      s.popping = false;
+      s.blob.init(s.blob.x(), s.blob.y(), k_stageRadius[s.stage] * 0.3f);
+      s.blob.setRadius(k_stageRadius[s.stage]);
+      s.blob.impulse(0, -150);
+      for (Particle& p : s.particles) {
+        if (p.kind == PKind::Drop) {
+          p.life = 0;
+        }
+      }
+      say("...PLOP ! Je suis\nrevenu. C'\xC3\xA9tait g\xC3\xA9nial.", Face::Joy,
+          3000);
+    }
+  } else {
+    s.blob.step(dt, env, c);
+  }
+  float impact = s.blob.takeImpact();
+  if (impact > 380) {
+    shake(impact / 120, 250);
+    dust(s.blob.x(), s.flipped ? s.blob.top() : s.blob.bottom(), 8);
+    if (impact > 650 && (rnd() % 2) == 0) {
+      say("OUF !", Face::Dizzy, 900);
+    }
+  }
+  updateMinis(dt, env);
+  updatePellets(dt, env);
+  chooseTarget();
+  updateEating();
+  ambient(dt);
+  // Camera: a bit ahead of where it looks
+  s.camTarget = s.blob.x() - k_screenWidth / 2 + s.facing * 30;
+  float maxCam = s.worldWidth - k_screenWidth;
+  s.camTarget = s.camTarget < 0 ? 0 : (s.camTarget > maxCam ? maxCam : s.camTarget);
+  s.camX += (s.camTarget - s.camX) * (dt * 5 > 1 ? 1 : dt * 5);
+}
+
+void setBiome(Biome b, bool talk) {
+  s.biome = b;
+  if (talk) {
+    say(biome().line, b == Biome::Disco ? Face::Joy : Face::Wow, 3000);
+    confetti(s.blob.x(), s.blob.y(), 12);
+  }
+  for (Particle& p : s.particles) {
+    if (p.kind == PKind::Firefly || p.kind == PKind::Ember ||
+        p.kind == PKind::Bubble) {
+      p.life = 0;
+    }
+  }
+}
+
+void startWorld() {
+  s.mode = Mode::World;
+  s.modeStart = s.now;
+  s.lastInput = s.now;
+  if (!s.introDone) {
+    s.introDone = true;
+    s.message.text[0] = 0;
+    for (const char* line : k_intro) {
+      queue(line, Face::Joy, 3600);
+    }
+  }
+}
