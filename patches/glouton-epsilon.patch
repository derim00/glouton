+void attach() {
+  s_attached = true;
+  s_launch = k_noItem;
+  s.now = s.last = clockMs();
+  buildWorld();
+  s.userBrightness = GlobalPreferences::SharedGlobalPreferences()->brightnessLevel();
+  s.brightness = s.userBrightness;
+  bool first = !s.initialized;
+  if (first) {
+    s.initialized = true;
+    s.random = 0x9E3779B9u ^ Ion::random();
+    if (s.random == 0) {
+      s.random = 1;
+    }
+    s.biome = Biome::Night;
+    s.hud = true;
+    s.ledOn = s.lightOn = true;
+    s.facing = 1;
+    s.hunger = 55;
+    s.weight = 120;
+    s.inflation = 1.f;
+    s.goneItem = s.lastLaunched = -1;
+    s.birth = s.now;
+    s.camX = 0;
+    s.blob.init(160, k_floorY - 20, k_stageRadius[0]);
+    s.mode = Mode::Boot;
+    s.modeStart = s.now;
+    s.lastInput = s.now;
+    s.foodSeen = Food::produced();
+  } else {
+    // Back from an app: GLOUTON spits you out
+    s.mode = Mode::World;
+    s.modeStart = s.now;
+    s.lastInput = s.now;
+    s.irisStart = s.now;
+    s.message.text[0] = 0;
+    s.queueLength = 0;
+    s.eat = EatPhase::None;
+    s.sleeping = false;
+    if (s.goneItem >= 0) {
+      sparkles(s_items[s.goneItem].x, s_items[s.goneItem].y, 14, rgb(0xFFFFFF));
+    }
+    s.goneItem = -1;
+    if (s.launches > 0) {
+      s.blob.squeeze(-3.f);
+      s.blob.impulse(s.facing * 60.f, -120.f);
+      say(k_spit[rnd() % count(k_spit)], Face::Joy, 1200);
+      int last = s.lastLaunched;
+      if (last >= 0 && last < s_numberOfItems) {
+        if (isGame(last)) {
+          queue("Tu as jou\xC3\xA9 SANS MOI ?!", Face::Angry, 3000);
+        } else if (s_items[last].info) {
+          queue(s_items[last].info->back, Face::Happy, 3200);
+        }
+      }
+      uint32_t away = (s.now - s.detachTime) / 60000;
+      if (away >= 3) {
+        char line[80];
+        Str m(line, sizeof(line));
+        m.add("Tu m'as laiss\xC3\xA9 seul\n").addInt(away).add(" minutes. J'ai compt\xC3\xA9.");
+        queue(line, Face::Hungry, 3500);
+      }
+    }
+    int n = collectFood();
+    if (n > 0) {
+      queue(n > 1 ? "Des r\xC3\xA9sultats !!! Il en\npleut ! \xC3\x80 TABLE !"
+                  : "Oh ! Un r\xC3\xA9sultat tout\nfrais. MIAM.",
+            Face::Love, 3000);
+    }
+  }
+  frame();
+#if !PLATFORM_DEVICE
+  const char* shots = getenv("GLOUTON_SHOTS");
+  if (shots && first) {
+    s_shotDir = shots;
+    photoSession();
+    exit(0);
+  }
+#endif
+}
