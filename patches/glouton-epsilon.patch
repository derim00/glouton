+int batteryPercent() {
+  float v = Ion::Battery::voltage();
+  int p = static_cast<int>((v - 3.6f) * 100.f / (4.15f - 3.6f));
+  return p < 0 ? 0 : (p > 100 ? 100 : p);
+}
+
+void drawHud(Band& b) {
+  if (!s.hud || (b.clip().y > 30 && b.clip().bottom() < 200)) {
+    return;
+  }
+  KDColor ink = rgb(0x1A1030);
+  // Hunger gauge, with a little face
+  Rect pill = {4, 4, 116, 20};
+  roundFill(b, pill, 10, rgb(0xFFFFFF), 215);
+  roundFrame(b, pill, 10, ink, 200);
+  KDColor body = baseColor();
+  ellipse(b, 15, 14, 7, 6.5f, mix(body, ink, 160));
+  ellipse(b, 15, 14, 6, 5.5f, body);
+  fill(b, {12, 12, 2, 2}, ink);
+  fill(b, {17, 12, 2, 2}, ink);
+  text(b, "FAIM", 26, 7, ink, Small);
+  Rect bar = {62, 10, 52, 8};
+  roundFill(b, bar, 4, rgb(0xE3E0EA));
+  int w = static_cast<int>(52 * s.hunger / 100);
+  if (w > 2) {
+    KDColor c = s.hunger < 50 ? rgb(0x4CD964)
+                              : (s.hunger < 80 ? rgb(0xFFB020) : rgb(0xFF3B30));
+    if (s.hunger >= 80 && (s.now / 300) % 2) {
+      c = rgb(0xFF8A80);
+    }
+    roundFill(b, {bar.x, bar.y, w, bar.h}, 4, c);
+  }
+  // Battery
+  int bp = batteryPercent();
+  Rect bat = {k_screenWidth - 44, 6, 32, 15};
+  roundFill(b, {bat.x - 4, 4, 46, 20}, 10, rgb(0xFFFFFF), 215);
+  roundFrame(b, {bat.x - 4, 4, 46, 20}, 10, ink, 200);
+  frame(b, {bat.x + 2, 9, 24, 10}, ink);
+  fill(b, {bat.x + 26, 12, 2, 4}, ink);
+  fill(b, {bat.x + 4, 11, 20 * bp / 100, 6},
+       bp < 20 ? rgb(0xFF3B30) : rgb(0x34C759));
+  // Bottom hint
+  if (s.mode != Mode::World || b.clip().bottom() < 212) {
+    return;
+  }
+  char hint[60];
+  Str h(hint, sizeof(hint));
+  if (s.targetKind == 1 && s.eat == EatPhase::None) {
+    h.add("OK : manger ").add(itemName(s.targetIndex));
+  } else if (s.targetKind == 2 && s.eat == EatPhase::None) {
+    h.add("OK : avaler ").add(s.pellets[s.targetIndex].text);
+  } else if (s.now - s.modeStart < 25000 && s.launches == 0) {
+    h.add("< > bouger  haut sauter  OK langue");
+  } else {
+    return;
+  }
+  int tw = textWidth(hint) + 16;
+  Rect r = {(k_screenWidth - tw) / 2, 219, tw, 18};
+  roundFill(b, r, 9, rgb(0x1A1030), 200);
+  text(b, hint, k_screenWidth / 2, 221, rgb(0xFFFFFF), Small, Align::Center);
+}
+
+void drawBites(Band& b) {
+  for (int i = 0; i < s.numberOfBites; i++) {
+    const Bite& bt = s.bites[i];
+    disc(b, bt.x, bt.y, bt.r, rgb(0x000000));
+    for (int k = 0; k < 4; k++) {
+      float a = k * 1.7f + i;
+      disc(b, bt.x + static_cast<int>(cosf(a) * bt.r * 0.8f),
+           bt.y + static_cast<int>(sinf(a) * bt.r * 0.8f), bt.r / 2, rgb(0x000000));
+    }
+  }
+}
+
+void iris(Band& b, float cx, float cy, float r) {
+  const Rect& clip = b.clip();
+  for (int y = clip.y; y < clip.bottom(); y++) {
+    KDColor* row = b.row(y);
+    float dy = y + 0.5f - cy;
+    float half = r * r - dy * dy;
+    int x0 = clip.right(), x1 = clip.right();
+    if (half > 0) {
+      float hw = sqrtf(half);
+      x0 = static_cast<int>(cx - hw);
+      x1 = static_cast<int>(cx + hw);
+    } else {
+      x0 = clip.right();
+      x1 = clip.right();
+    }
+    for (int x = clip.x; x < clip.right(); x++) {
+      if (half <= 0 || x < x0 || x >= x1) {
+        row[x] = rgb(0x000000);
+      }
+    }
+  }
+}
