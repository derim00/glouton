+void detach() {
+  s.detachTime = clockMs();
+  restoreLed();
+  if (s.brightness != s.userBrightness && !s_fake) {
+    Ion::Backlight::setBrightness(s.userBrightness);
+  }
+  s.brightness = s.userBrightness;
+  s_attached = false;
+}
+
+Item takeLaunch() {
+  Item it = s_launch;
+  s_launch = k_noItem;
+  return it;
+}
+
+int framePeriod() {
+  if (s.sleeping && s.mode == Mode::World) {
+    return 110;  // it sleeps: save the battery
+  }
+  if (s.mode == Mode::Notebook) {
+    return 120;
+  }
+  return 30;
+}
+
+bool handleEvent(Event e) {
+  if (!s_attached) {
+    return false;
+  }
+  if (!e.isKeyboardEvent() || e == Events::OnOff) {
+    return false;
+  }
+  if (e == Events::Shift || e == Events::Alpha || e == Events::AlphaCaps) {
+    return false;
+  }
+  s.now = clockMs();
+  s.lastInput = s.now;
+  Ion::Keyboard::State keys = scanKeys();
+  switch (s.mode) {
+    case Mode::Boot: {
+      uint32_t t = s.now - s.modeStart;
+      if (t < 3300) {
+        // Knocking on the egg makes it hatch sooner
+        s.modeStart -= 450;
+        shake(2, 150);
+      } else if (t > 4000) {
+        startWorld();
+      }
+      return true;
+    }
+    case Mode::Digest:
+      return true;
+    case Mode::Fridge: {
+      int perPage = k_fridgeColumns * k_fridgeRows;
+      int i = s.menuSelected;
+      if (e == Events::Left) {
+        i--;
+      } else if (e == Events::Right) {
+        i++;
+      } else if (e == Events::Up) {
+        i -= k_fridgeColumns;
+      } else if (e == Events::Down) {
+        i += k_fridgeColumns;
+      } else if (e == Events::OK || e == Events::EXE) {
+        eatFromFridge(s.menuSelected);
+        return true;
+      } else if (e == Events::Back || e == Events::Home) {
+        s.mode = Mode::World;
+        return true;
+      }
+      if (i < 0) {
+        i = 0;
+      }
+      if (i >= s_numberOfItems) {
+        i = s_numberOfItems - 1;
+      }
+      (void)perPage;
+      s.menuSelected = i;
+      return true;
+    }
+    case Mode::Notebook:
+      if (e == Events::Left || e == Events::Right) {
+        s.notebookPage = 1 - s.notebookPage;
+      } else if (e == Events::One) {
+        s.ledOn = !s.ledOn;
+      } else if (e == Events::Two) {
+        s.lightOn = !s.lightOn;
+      } else if (e == Events::Back || e == Events::Home || e == Events::Toolbox ||
+                 e == Events::OK) {
+        s.mode = Mode::World;
+      }
+      return true;
+    default:
+      break;
+  }
+  // World
+  if (s.sleeping) {
+    s.sleeping = false;
+    s.blob.impulse(0, -200);
+    shake(3, 300);
+    say("HEIN ?! Je dormais pas.", Face::Wow, 2200);
+    return true;
+  }
+  if (e == Events::Left || e == Events::Right) {
+    Key k = e == Events::Left ? Key::Left : Key::Right;
+    s.facing = e == Events::Left ? -1 : 1;
+    if (!keys.keyDown(k)) {
+      s.blob.impulse(s.facing * 90.f, 0);
+    }
+    return true;
+  }
+  if (e == Events::Up || e == Events::EXE) {
+    s.jumpRequest = true;
+    return true;
+  }
+  if (e == Events::Down) {
+    if (s.blob.grounded()) {
+      s.blob.squeeze(2.5f);
+    } else {
+      s.slamRequest = true;
+    }
+    return true;
+  }
+  if (e == Events::OK) {
+    tongue();
+    return true;
+  }
+  if (e == Events::Back || e == Events::Home) {
+    s.mode = Mode::Fridge;
+    s.modeStart = s.now;
+    if (s.menuSelected >= s_numberOfItems) {
+      s.menuSelected = 0;
+    }
+    return true;
+  }
+  if (e == Events::Toolbox) {
+    s.mode = Mode::Notebook;
+    s.notebookPage = 0;
+    return true;
+  }
+  if (e == Events::Var) {
+    s.hud = !s.hud;
+    return true;
+  }
+  if (e == Events::Ans) {
+    say(k_jokes[s.jokeIndex % count(k_jokes)], Face::Joy, 4500);
+    s.jokeIndex++;
+    return true;
+  }
+  if (e == Events::Pi) {
+    s.partyUntil = s.now + 5000;
+    confetti(s.blob.x(), s.blob.y() - 40, 50);
+    say("\xCF\x80 ! \xCF\x80 ! \xCF\x80 !\n3,14159265358979...", Face::Love, 3500);
+    return true;
+  }
+  if (e == Events::Square) {
+    if (s.popping) {
+      return true;
+    }
+    s.inflation += 0.2f;
+    s.hugeUntil = s.now + 2500;
+    s.blob.setInflation(s.inflation);
+    s.blob.jiggle(80, rnd());
+    if (s.inflation > 1.95f) {
+      s.hugeUntil = 0;
+      startPop();
+    } else if (s.inflation > 1.7f) {
+      say("STOP ! Je vais\nEXPLOSEEER !!!", Face::Wow, 1500);
+    } else if (s.inflation > 1.3f) {
+      say("x\xC2\xB2... je gonfle !", Face::Wow, 1500);
+    }
+    return true;
+  }
+  if (e == Events::Sqrt) {
+    s.inflation -= 0.2f;
+    if (s.inflation < 0.55f) {
+      s.inflation = 0.55f;
+      say("Plus petit, je peux pas.\nJe suis un bonsa\xC3\xAF.", Face::Dizzy, 2000);
+    } else {
+      say("\xE2\x88\x9A : je r\xC3\xA9tr\xC3\xA9""cis !", Face::Wow, 1200);
+    }
+    s.hugeUntil = s.now + 6000;
+    s.blob.setInflation(s.inflation);
+    return true;
+  }
+  if (e == Events::Multiplication) {
+    if (s.numberOfMinis < k_maxMinis) {
+      Mini& m = s.minis[s.numberOfMinis++];
+      m = {s.blob.x(), s.blob.y(), -s.facing * 120.f, -200.f, 0.4f, 0};
+      sparkles(s.blob.x(), s.blob.y(), 8, rgb(0xFFFFFF));
+      char line[40];
+      Str l(line, sizeof(line));
+      l.add("GLOUTON \xC3\x97").addInt(s.numberOfMinis + 1).add(" !");
+      say(line, Face::Joy, 1500);
+    } else {
+      say("Trop de clones. Ils vont\nmanger MA nourriture.", Face::Angry, 2500);
+    }
+    return true;
+  }
+  if (e == Events::Division) {
+    if (s.numberOfMinis > 0) {
+      for (int i = 0; i < s.numberOfMinis; i++) {
+        sparkles(s.minis[i].x, s.minis[i].y, 5, rgb(0xFFFFFF));
+      }
+      s.numberOfMinis = 0;
+      s.blob.jiggle(160, rnd());
+      say("\xC3\xB7 : on fusionne !\n*sluuurp*", Face::Joy, 1800);
+    } else {
+      say("Diviser par moi-m\xC3\xAAme ?\n\xC3\x87""a fait 1. Toujours moi.", Face::Happy,
+          2500);
+    }
+    return true;
+  }
+  if (e == Events::Sine) {
+    s.danceUntil = s.now + 5000;
+    say("sin(x) ! Danse\nsinuso\xC3\xAF""dale !", Face::Joy, 2000);
+    return true;
+  }
+  if (e == Events::Cosine) {
+    s.costume = (s.costume + 1) % k_numberOfCostumes;
+    sparkles(s.blob.x(), s.blob.top(), 10, rgb(0xFFF07A));
+    char line[60];
+    Str l(line, sizeof(line));
+    l.add("cos(tume) : ").add(k_costumeNames[s.costume]);
+    say(line, Face::Joy, 1500);
+    return true;
+  }
+  if (e == Events::Tangent) {
+    s.tanned = !s.tanned;
+    say(s.tanned ? "tan : bronzage MAX.\nJe suis en vacances."
+                 : "Fini les vacances.",
+        Face::Joy, 2000);
+    return true;
+  }
+  if (e == Events::Imaginary) {
+    s.ghost = !s.ghost;
+    say(s.ghost ? "Je suis imaginaire.\nTu me vois ? Non."
+                : "Je suis r\xC3\xA9""el \xC3\xA0 nouveau !",
+        Face::Wow, 2200);
+    return true;
+  }
+  if (e == Events::Minus) {
+    s.flipped = !s.flipped;
+    shake(3, 300);
+    say(s.flipped ? "GRAVIT\xC3\x89 N\xC3\x89GATIVE !\nJ'ai le vertiiige !"
+                  : "Ouf, le sol.", Face::Wow, 2000);
+    return true;
+  }
+  if (e == Events::Ln || e == Events::Log) {
+    s.sleeping = true;
+    say("ln : je dors comme\nune b\xC3\xBB""che. zZz", Face::Sleep, 2000);
+    return true;
+  }
+  if (e == Events::Backspace) {
+    if (s.now - s.lastPoke > 3000) {
+      s.pokes = 0;
+    }
+    s.lastPoke = s.now;
+    s.pokes++;
+    s.blob.jiggle(220, rnd());
+    if (s.pokes >= 6) {
+      s.pokes = 0;
+      s.angryUntil = s.now + 5000;
+      shake(5, 500);
+      for (int i = 0; i < 6; i++) {
+        spawn(PKind::Steam, s.blob.x() + (i % 2 ? 12 : -12), s.blob.top(),
+              (i % 2 ? 30 : -30), -40, 900, rgb(0xFFFFFF), 4);
+      }
+      say("ARR\xC3\x8ATE !!!\nJe suis chatouilleux !!", Face::Angry, 2500);
+    } else {
+      static constexpr const char* k_giggles[] = {"Hihihi !", "Hahaha !",
+                                                  "Arr\xC3\xAAte \xC3\xA7""a !",
+                                                  "HIHIHIHI"};
+      say(k_giggles[rnd() % count(k_giggles)], Face::Joy, 900);
+      spawn(PKind::Heart, s.blob.x(), s.blob.top(), 0, -40, 900, rgb(0xFF4F8B), 1);
+    }
+    return true;
+  }
+  if (e == Events::Plus) {
+    long v = 1 + rnd() % 99;
+    char out[8];
+    Str o(out, sizeof(out));
+    o.addInt(v);
+    spawnPellet("+", out, s.blob.x() + s.facing * 50);
+    say("Un en-cas !", Face::Love, 1000);
+    return true;
+  }
+  constexpr Event k_biomeKeys[] = {Events::One, Events::Two, Events::Three,
+                                   Events::Four, Events::Five, Events::Six};
+  for (int i = 0; i < k_numberOfBiomes; i++) {
+    if (e == k_biomeKeys[i]) {
+      if (i == static_cast<int>(Biome::Disco) && !s.discoUnlocked) {
+        say("Secret. Nourris-moi\nd'abord. Beaucoup.", Face::Happy, 2500);
+        return true;
+      }
+      if (static_cast<int>(s.biome) != i) {
+        setBiome(static_cast<Biome>(i), true);
+      }
+      return true;
+    }
+  }
+  return true;
+}
+
+bool frame() {
+  if (!s_attached) {
+    return false;
+  }
+  s.now = clockMs();
+  float dt = (s.now - s.last) / 1000.f;
+  if (dt > 0.05f) {
+    dt = 0.05f;
+  }
+  s.last = s.now;
+  updateMessages();
+  if (s.now < s.shakeUntil) {
+    int a = static_cast<int>(s.shakeAmp * (s.shakeUntil - s.now) / 300.f + 0.5f);
+    a = a > 8 ? 8 : a;
+    s_shakeX = a > 0 ? static_cast<int>(rnd() % (2 * a + 1)) - a : 0;
+    s_shakeY = a > 0 ? static_cast<int>(rnd() % (2 * a + 1)) - a : 0;
+  } else {
+    s_shakeX = s_shakeY = 0;
+  }
+  if (s.mode == Mode::Boot) {
+    updateBoot(dt);
+    if (s.now - s.modeStart > 7600) {
+      startWorld();
+    }
+  } else if (s.mode != Mode::Digest) {
+    hungerLife(dt);
+    if (s.mode == Mode::World) {
+      updateWorld(dt, scanKeys());
+    }
+    updateParticles(dt);
+  }
+  prepareBackground();
+  updateLed();
+  updateBacklight();
+  return true;
+}
+
+void render(Band& b) {
+  if (!s_attached) {
+    fill(b, b.area(), rgb(0x000000));
+    return;
+  }
+  switch (s.mode) {
+    case Mode::Boot:
+      renderBoot(b);
+      return;
+    case Mode::Digest:
+      renderDigest(b);
+      return;
+    case Mode::Fridge:
+      drawFridge(b);
+      return;
+    case Mode::Notebook:
+      drawNotebook(b);
+      return;
+    default:
+      break;
+  }
+  renderWorld(b);
+  if (s.evolveStart && s.now - s.evolveStart < 2400) {
+    drawEvolution(b);
+  }
+  // Coming back from an app: the mouth opens
+  uint32_t open = s.now - s.irisStart;
+  if (s.launches > 0 && open < 600) {
+    float k = open / 600.f;
+    float mx, my;
+    mouth(&mx, &my);
+    iris(b, mx - camX(), my - camY(), 420 * k * k);
+  }
+  if (!s.hud && s.mode == Mode::World) {
+    text(b, "MODE PHOTO  (var)", k_screenWidth - 6, k_screenHeight - 16,
+         rgb(0xFFFFFF), Small, Align::Right, k_screenWidth, 140);
+  }
+  drawBites(b);
+  if (s.now < s.flashUntil) {
+    fill(b, b.area(), rgb(0xFFFFFF), 160);
+  }
+}
+
+}  // namespace Shell
+
+}  // namespace Glouton
+}  // namespace Home
