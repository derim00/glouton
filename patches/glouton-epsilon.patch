+
+void spawn(PKind kind, float x, float y, float vx, float vy, int life,
+           KDColor color, int size = 2) {
+  // Reuse the particle closest to its end
+  int best = 0;
+  uint16_t bestLife = 0xFFFF;
+  for (int i = 0; i < k_maxParticles; i++) {
+    if (s.particles[i].life == 0) {
+      best = i;
+      break;
+    }
+    if (s.particles[i].life < bestLife) {
+      bestLife = s.particles[i].life;
+      best = i;
+    }
+  }
+  Particle& p = s.particles[best];
+  p = {x, y, vx, vy, static_cast<uint16_t>(life), static_cast<uint16_t>(life),
+       kind, static_cast<uint8_t>(size), static_cast<uint16_t>(color)};
+}
+
+void confetti(float x, float y, int n) {
+  for (int i = 0; i < n; i++) {
+    float a = frnd() * 2 * k_pi;
+    float v = 60 + frnd() * 200;
+    spawn(PKind::Confetti, x, y, cosf(a) * v, sinf(a) * v - 120,
+          900 + rnd() % 700, hsv(rnd() % 360, 200, 255), 2 + rnd() % 2);
+  }
+}
+
+void sparkles(float x, float y, int n, KDColor c) {
+  for (int i = 0; i < n; i++) {
+    float a = frnd() * 2 * k_pi;
+    float v = 30 + frnd() * 90;
+    spawn(PKind::Spark, x, y, cosf(a) * v, sinf(a) * v, 500 + rnd() % 400, c,
+          2 + rnd() % 2);
+  }
+}
+
+void crumbs(float x, float y, int n, KDColor c) {
+  for (int i = 0; i < n; i++) {
+    spawn(PKind::Crumb, x, y, (frnd() - 0.5f) * 160, -60 - frnd() * 120,
+          700, c, 2);
+  }
