+/* ================================================================ items */
+
+const AppInfo* appInfo(I18n::Message name) {
+  for (const AppInfo& info : k_appInfos) {
+    if (info.name == name) {
+      return &info;
+    }
+  }
+  return nullptr;
+}
+
+bool isGame(int i) { return s_items[i].item.kind == Item::Kind::External; }
+
+const char* itemName(int i) {
+  if (isGame(i)) {
+    return AppsContainer::sharedAppsContainer()
+        ->externalAppAtIndex(s_items[i].item.index)
+        .name();
+  }
+  return I18n::translate(AppsContainer::sharedAppsContainer()
+                             ->appSnapshotAtIndex(PermutedAppSnapshotIndex(
+                                 s_items[i].item.index))
+                             ->descriptor()
+                             ->name());
+}
+
+void itemSymbol(int i, char* out) {
+  if (s_items[i].info) {
+    strlcpy(out, s_items[i].info->symbol, 8);
+    return;
+  }
+  const char* label = itemName(i);
+  int n = 0;
+  while (n < 3 && label[n] && static_cast<uint8_t>(label[n]) < 0x80) {
+    out[n] = label[n];
+    n++;
+  }
+  out[n] = 0;
+}
+
+KDColor itemColor(int i) {
+  if (isGame(i)) {
+    return rgb(0xE8463C);
+  }
+  if (s_items[i].hue < 0) {
+    return rgb(0x9AA0AE);
+  }
+  return hsv(s_items[i].hue, 190, 240);
+}
+
+void buildWorld() {
+  AppsContainer* container = AppsContainer::sharedAppsContainer();
+  int builtin = container->numberOfBuiltinApps();
+  s_numberOfItems = 0;
+  for (int appIndex = 1;
+       appIndex < builtin && s_numberOfItems < k_maxBuiltin; appIndex++) {
+    I18n::Message name =
+        container->appSnapshotAtIndex(PermutedAppSnapshotIndex(appIndex))
+            ->descriptor()
+            ->name();
+    ItemSlot& it = s_items[s_numberOfItems++];
+    it.item = {Item::Kind::Builtin, static_cast<int16_t>(appIndex)};
+    it.info = appInfo(name);
+    it.hue = it.info ? it.info->hue : (s_numberOfItems * 47) % 360;
+  }
+  s_numberOfBuiltin = s_numberOfItems;
+  int games = container->numberOfExternalApps();
+  for (int i = 0; i < games && i < k_maxGames; i++) {
+    ItemSlot& it = s_items[s_numberOfItems++];
+    it.item = {Item::Kind::External, static_cast<int16_t>(i)};
+    it.info = nullptr;
+    it.hue = 0;
+  }
+  /* The apps float along the terrarium, the games wait in the toy chest at
+   * the end, after a gap. */
+  constexpr float k_start = 150.f, k_spacing = 76.f;
+  float x = k_start;
+  s_numberOfPlatforms = 0;
+  for (int i = 0; i < s_numberOfItems; i++) {
+    if (i == s_numberOfBuiltin && i > 0) {
+      x += 70.f;
+    }
+    s_items[i].x = x;
+    s_items[i].y = (i % 2 == 0) ? 150.f : 112.f;
+    if (i % 3 == 1 && s_numberOfPlatforms < k_maxPlatforms) {
+      s_platforms[s_numberOfPlatforms++] = {
+          static_cast<int16_t>(x + k_spacing * 0.5f - 30), 168, 60};
+    }
+    x += k_spacing;
+  }
+  s.worldWidth = x + 90.f;
+  if (s.worldWidth < 2 * k_screenWidth) {
+    s.worldWidth = 2 * k_screenWidth;
+  }
+  if (s.goneItem >= s_numberOfItems) {
+    s.goneItem = -1;
+  }
+}
+
+float itemBob(int i) { return 4.f * sinf(s.now * 0.0025f + i * 1.3f); }
