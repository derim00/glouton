+  }
+}
+
+void drawEye(Band& b, float ex, float ey, float rx, float ry, float lx, float ly,
+             Face face, KDColor body, int side) {
+  KDColor ink = rgb(0x14101E);
+  switch (face) {
+    case Face::Joy:
+    case Face::Chew:
+      arc(b, ex, ey + ry * 0.4f, rx * 0.85f, 2.2f, 1, ink);
+      return;
+    case Face::Sleep:
+      arc(b, ex, ey - ry * 0.2f, rx * 0.8f, 2.f, 2, ink);
+      return;
+    case Face::Love:
+      heart(b, static_cast<int>(ex - 9), static_cast<int>(ey - 7), 2, rgb(0xFF2E63));
+      return;
+    case Face::Sick:
+      line(b, ex - rx * 0.7f, ey - ry * 0.5f, ex + rx * 0.7f, ey + ry * 0.5f, 2.2f, ink);
+      line(b, ex - rx * 0.7f, ey + ry * 0.5f, ex + rx * 0.7f, ey - ry * 0.5f, 2.2f, ink);
+      return;
+    case Face::Dizzy: {
+      ellipse(b, ex, ey, rx + 1, ry + 1, ink);
+      ellipse(b, ex, ey, rx, ry, rgb(0xFFFFFF));
+      arc(b, ex, ey, rx * 0.55f, 1.6f, 0, ink);
+      float a = s.now * 0.02f * side;
+      ellipse(b, ex + cosf(a) * rx * 0.3f, ey + sinf(a) * ry * 0.3f, 2, 2, ink);
+      return;
+    }
+    default:
+      break;
+  }
+  bool blink = (s.now % 3900) < 110 && face != Face::Wow && face != Face::Evil;
+  if (blink) {
+    line(b, ex - rx, ey, ex + rx, ey, 2, ink);
+    return;
+  }
+  float pr = rx * (face == Face::Wow ? 0.38f : 0.56f);
+  ellipse(b, ex, ey, rx + 1.4f, ry + 1.4f, ink);
+  ellipse(b, ex, ey, rx, ry, face == Face::Evil ? rgb(0xFFE3E3) : rgb(0xFFFFFF));
+  float px = ex + lx * (rx - pr) * 0.8f, py = ey + ly * (ry - pr) * 0.6f;
+  if (face == Face::Evil) {
+    ellipse(b, px, py, pr + 2, pr + 2, rgb(0xFF0000), 100);
+    ellipse(b, px, py, pr, pr, rgb(0xE00000));
+  } else {
+    ellipse(b, px, py, pr, pr, ink);
+  }
+  ellipse(b, px - pr * 0.35f, py - pr * 0.4f, pr * 0.32f, pr * 0.32f, rgb(0xFFFFFF));
+  if (face == Face::Hungry) {
+    // Heavy eyelid
+    fill(b, {static_cast<int>(ex - rx - 2), static_cast<int>(ey - ry - 2),
+             static_cast<int>(2 * rx + 5), static_cast<int>(ry + 1)}, body);
+    line(b, ex - rx - 1, ey - 1, ex + rx + 1, ey - 1, 2, ink);
+  }
+  if (face == Face::Angry || face == Face::Evil) {
+    line(b, ex - rx * 1.1f * side, ey - ry * 1.5f, ex + rx * 0.9f * side,
+         ey - ry * 0.75f, 3, ink);
+  }
+}
+
+// The face, the hats: drawn over the body. (cx, cy) on screen.
+void drawFace(Band& b, float cx, float cy, float hw, float hh, Face face,
+              KDColor body, float lx, float ly) {
+  float big = s.stage == 0 ? 0.25f : 0.21f;
+  float rx = hw * big, ry = rx * 1.2f * (hh / (hw > 1 ? hw : 1));
+  ry = ry < 2 ? 2 : ry;
+  float ex = hw * 0.37f, ey = cy - hh * 0.17f;
+  float shift = lx * hw * 0.08f;
+  bool glasses = s.costume == 4 || (s.tanned && s.costume == 0);
+  if (glasses) {
+    face = face == Face::Sleep ? face : Face::Happy;
+  }
+  drawEye(b, cx - ex + shift, ey, rx, ry, lx, ly, face, body, -1);
+  drawEye(b, cx + ex + shift, ey, rx, ry, lx, ly, face, body, 1);
+  KDColor ink = rgb(0x14101E);
+  float mx = cx + shift * 1.5f, my = cy + hh * 0.24f;
+  float mw = hw * 0.2f;
+  // Cheeks
+  if (face == Face::Happy || face == Face::Joy || face == Face::Love ||
+      face == Face::Chew) {
+    float puff = face == Face::Chew ? 1.6f : 1.f;
+    ellipse(b, cx - ex * 1.25f + shift, my - 2, hw * 0.13f * puff, hh * 0.08f * puff,
+            rgb(0xFF6A8E), 110);
+    ellipse(b, cx + ex * 1.25f + shift, my - 2, hw * 0.13f * puff, hh * 0.08f * puff,
+            rgb(0xFF6A8E), 110);
+  }
+  switch (face) {
+    case Face::Happy:
+    case Face::Love:
+      arc(b, mx, my - mw * 0.6f, mw, 2.2f, 2, ink);
+      break;
+    case Face::Joy:
+    case Face::Evil:
+      ellipse(b, mx, my, mw * 1.1f + 1.2f, hh * 0.15f + 1.2f, ink);
+      ellipse(b, mx, my + hh * 0.06f, mw * 0.7f, hh * 0.07f, rgb(0xFF5C7A));
+      fill(b, {static_cast<int>(mx - mw * 1.1f), static_cast<int>(my - hh * 0.16f),
+               static_cast<int>(mw * 2.2f + 2), static_cast<int>(hh * 0.12f)},
+           body);
+      if (face == Face::Evil) {
+        for (int t = -1; t <= 1; t += 2) {
+          float xs[3] = {mx + t * mw * 0.5f - 2, mx + t * mw * 0.5f + 2, mx + t * mw * 0.5f};
+          float ys[3] = {my - hh * 0.04f, my - hh * 0.04f, my + 3};
+          polygon(b, xs, ys, 3, rgb(0xFFFFFF));
+        }
+      }
+      break;
+    case Face::Wow:
+      ellipse(b, mx, my, mw * 0.55f + 1, hh * 0.13f + 1, ink);
+      ellipse(b, mx, my + 1, mw * 0.3f, hh * 0.06f, rgb(0xFF5C7A));
+      break;
+    case Face::Sleep:
+      ellipse(b, mx, my, 2.5f, 2, ink);
+      {
+        float r = 3 + 3 * (0.5f + 0.5f * sinf(s.now * 0.003f));
+        ellipse(b, cx + ex * 0.4f + shift, cy + hh * 0.05f + r, r, r,
+                rgb(0xBFE8FF), 130);
+      }
+      break;
+    case Face::Angry:
+      line(b, mx - mw, my, mx + mw, my, 2.2f, ink);
+      break;
+    case Face::Sick:
+    case Face::Dizzy:
+      for (int k = 0; k < 4; k++) {
+        float x0 = mx - mw + k * mw * 0.5f;
+        line(b, x0, my + (k % 2 ? 2 : -1), x0 + mw * 0.5f, my + (k % 2 ? -1 : 2), 2,
+             ink);
+      }
+      break;
+    case Face::Hungry:
+      arc(b, mx, my + mw * 0.6f, mw * 0.8f, 2.f, 1, ink);
+      {
+        float d = fmodf(s.now * 0.02f, 18.f);
+        ellipse(b, mx + mw * 0.7f, my + 2 + d, 1.6f, 2.2f, rgb(0xBFE8FF), 220);
+      }
+      break;
+    case Face::Chew: {
+      float o = (s.now / 170) % 2 ? 2.5f : 0.8f;
+      ellipse(b, mx, my, mw * 0.6f, o, ink);
+      break;
+    }
+  }
+  if (glasses) {
+    KDColor lens = rgb(0x101018);
+    roundFill(b, {static_cast<int>(cx - ex + shift - rx * 1.4f), static_cast<int>(ey - ry),
+                  static_cast<int>(rx * 2.8f), static_cast<int>(ry * 1.8f + 1)},
+              3, lens);
+    roundFill(b, {static_cast<int>(cx + ex + shift - rx * 1.4f), static_cast<int>(ey - ry),
+                  static_cast<int>(rx * 2.8f), static_cast<int>(ry * 1.8f + 1)},
+              3, lens);
+    line(b, cx - ex + shift, ey - ry * 0.5f, cx + ex + shift, ey - ry * 0.5f, 2, lens);
+    line(b, cx - ex + shift - rx, ey + ry * 0.4f, cx - ex + shift - rx * 0.2f,
+         ey - ry * 0.6f, 1.2f, rgb(0xFFFFFF), 160);
+  }
+  if (s.costume == 5) {
+    for (int t = -1; t <= 1; t += 2) {
+      ellipse(b, mx + t * mw * 0.7f, my - hh * 0.1f, mw * 0.75f, hh * 0.06f + 1, rgb(0x3A2414));
+      ellipse(b, mx + t * mw * 1.45f, my - hh * 0.14f, 2, 2, rgb(0x3A2414));
+    }
+  }
+}
+
+void drawHats(Band& b, float cx, float top, float hw) {
+  int costume = s.costume;
+  if (costume == 0 && s.stage == 3) {
+    costume = 3;  // the supreme glutton wears a crown
+  }
+  if (s.stage >= 1 && costume == 0) {
+    // A little sprout
+    float sway = sinf(s.now * 0.004f) * 2;
+    line(b, cx, top + 2, cx + sway, top - 7, 1.6f, rgb(0x2F7D32));
+    ellipse(b, cx + sway + 4, top - 8, 4.5f, 2.4f, rgb(0x4CC24A));
+    if (s.stage >= 2) {
+      ellipse(b, cx + sway - 4, top - 6, 3.5f, 2.f, rgb(0x4CC24A));
+    }
+  }
+  switch (costume) {
+    case 1: {
+      float xs[3] = {cx - 9, cx + 9, cx + 3};
+      float ys[3] = {top + 3, top + 3, top - 22};
+      polygon(b, xs, ys, 3, rgb(0xFF4FA3));
+      line(b, cx - 5, top - 4, cx + 6, top - 7, 2, rgb(0xFFE14A));
+      line(b, cx - 2, top - 12, cx + 5, top - 14, 2, rgb(0x5CE1FF));
+      ellipse(b, cx + 3, top - 22, 3.5f, 3.5f, rgb(0xFFE14A));
+      break;
+    }
+    case 2:
+      fill(b, {static_cast<int>(cx - 15), static_cast<int>(top - 2), 30, 4}, rgb(0x15151C));
+      fill(b, {static_cast<int>(cx - 10), static_cast<int>(top - 22), 20, 21}, rgb(0x15151C));
+      fill(b, {static_cast<int>(cx - 10), static_cast<int>(top - 7), 20, 4}, rgb(0xD7263D));
+      break;
+    case 3: {
+      float xs[7] = {cx - 13, cx - 13, cx - 6, cx, cx + 6, cx + 13, cx + 13};
+      float ys[7] = {top + 3, top - 11, top - 4, top - 15, top - 4, top - 11, top + 3};
+      polygon(b, xs, ys, 7, rgb(0xFFC928));
+      ellipse(b, cx, top - 3, 2.5f, 2.5f, rgb(0xE8243C));
+      ellipse(b, cx - 8, top - 2, 2, 2, rgb(0x2E8BFF));
+      ellipse(b, cx + 8, top - 2, 2, 2, rgb(0x2E8BFF));
+      break;
+    }
+    case 6:
+      for (int i = 0; i < 18; i++) {
+        float a = i * 2 * k_pi / 18 + s.now * 0.002f;
+        ellipse(b, cx + cosf(a) * (hw * 0.55f), top - 9 + sinf(a) * 3.5f, 1.8f, 1.8f,
+                rgb(0xFFE76A));
+      }
+      break;
+    default:
+      break;
+  }
+}
