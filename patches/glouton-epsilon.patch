+/* Parses a serialized result ("42", "-3.5", "1.2\xE1\xB4\x87""15") */
+bool parseNumber(const char* t, double* value) {
+  const char* p = t;
+  bool neg = false;
+  if (*p == '-') {
+    neg = true;
+    p++;
+  } else if (static_cast<uint8_t>(p[0]) == 0xE2 &&
+             static_cast<uint8_t>(p[1]) == 0x88 &&
+             static_cast<uint8_t>(p[2]) == 0x92) {
+    neg = true;
+    p += 3;
+  }
+  double v = 0;
+  int digits = 0;
+  while ((*p >= '0' && *p <= '9') || *p == ' ' ||
+         (static_cast<uint8_t>(p[0]) == 0xE2 && static_cast<uint8_t>(p[1]) == 0x80 &&
+          static_cast<uint8_t>(p[2]) == 0x89)) {
+    if (*p == ' ') {
+      p++;
+      continue;
+    }
+    if (static_cast<uint8_t>(*p) == 0xE2) {
+      p += 3;
+      continue;
+    }
+    v = v * 10 + (*p - '0');
+    p++;
+    digits++;
+  }
+  if (*p == '.') {
+    p++;
+    double f = 0.1;
+    while (*p >= '0' && *p <= '9') {
+      v += (*p - '0') * f;
+      f *= 0.1;
+      p++;
+      digits++;
+    }
+  }
+  if (digits == 0) {
+    return false;
+  }
+  if ((static_cast<uint8_t>(p[0]) == 0xE1 &&
+       static_cast<uint8_t>(p[1]) == 0xB4 &&
+       static_cast<uint8_t>(p[2]) == 0x87) ||
+      *p == 'E' || *p == 'e') {
+    p += (*p == 'E' || *p == 'e') ? 1 : 3;
+    bool eneg = false;
+    if (*p == '-') {
+      eneg = true;
+      p++;
+    } else if (static_cast<uint8_t>(p[0]) == 0xE2) {
+      eneg = true;
+      p += 3;
+    }
+    int e = 0;
+    while (*p >= '0' && *p <= '9') {
+      e = e * 10 + (*p - '0');
+      p++;
+    }
+    for (int i = 0; i < e && i < 400; i++) {
+      v = eneg ? v / 10 : v * 10;
+    }
+  }
+  if (*p != 0) {
+    return false;
+  }
+  *value = neg ? -v : v;
+  return true;
+}
