+Env environment() {
+  const BiomeInfo& bi = biome();
+  Env e;
+  float g = bi.gravity;
+  if (s.ghost) {
+    g *= 0.12f;
+  }
+  e.gravity = s.flipped ? -g : g;
+  e.drag = s.ghost ? 1.5f : bi.drag;
+  e.jumpHeight = bi.jump;
+  e.floorY = k_floorY;
+  e.ceilY = k_ceilY;
+  e.left = 4;
+  e.right = s.worldWidth - 4;
