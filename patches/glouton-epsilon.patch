+namespace {
+
+/* ============================================================ rendering */
+
+int s_shakeX = 0, s_shakeY = 0;
+float camX() { return floorf(s.camX) - s_shakeX; }
+float camY() { return static_cast<float>(-s_shakeY); }
+
+float wave(float x, float a, float f, float p) { return a * sinf(x * f + p); }
+
+void prepareBackground() {
+  const BiomeInfo& bi = biome();
+  KDColor top = rgb(bi.skyTop), bottom = rgb(bi.skyBottom);
+  for (int y = 0; y < k_screenHeight; y++) {
+    int t = y * 256 / static_cast<int>(k_floorY);
+    s_sky[y] = mix(top, bottom, t > 256 ? 256 : t);
+  }
+  float cx = camX();
+  for (int x = 0; x < k_screenWidth; x++) {
+    float far = cx * 0.3f + x, nearX = cx * 0.6f + x;
+    int f = 999, n = 999;
+    switch (s.biome) {
+      case Biome::Garden:
+      case Biome::Night:
+        f = static_cast<int>(150 + wave(far, 16, 0.011f, 0) +
+                             wave(far, 8, 0.029f, 2));
+        n = static_cast<int>(182 + wave(nearX, 10, 0.019f, 1) +
+                             wave(nearX, 5, 0.047f, 3));
+        break;
+      case Biome::Volcano: {
+        float d = fabsf(fmodf(far + 4000, 280) - 140);
+        float h = 105 - d * 0.95f;
+        h = h < 0 ? 0 : (h > 88 ? 88 - (h - 88) * 0.6f : h);
+        f = static_cast<int>(200 - h);
+        n = static_cast<int>(194 + wave(nearX, 6, 0.05f, 0) +
+                             wave(nearX, 4, 0.13f, 1));
+        break;
+      }
+      case Biome::Aquarium:
+        f = static_cast<int>(186 + wave(far, 9, 0.016f, 0));
+        break;
+      default:
+        break;
+    }
+    s_far[x] = f;
+    s_near[x] = n;
+  }
+}
+
+void drawStars(Band& b, int numberOfStars, float parallax, bool twinkle) {
+  float cx = camX() * parallax;
+  for (int i = 0; i < numberOfStars; i++) {
+    uint32_t h = hash(i * 7919 + 13);
+    int x = static_cast<int>((h % 1280) - cx) % 1280;
+    x = x < 0 ? x + 1280 : x;
+    if (x >= k_screenWidth) {
+      continue;
+    }
+    int y = (h >> 11) % 190;
+    if (y < b.clip().y - 1 || y > b.clip().bottom()) {
+      continue;
+    }
+    int a = 255;
+    if (twinkle) {
+      a = 120 + static_cast<int>(135 * sinf(s.now * 0.003f + (h & 0xFF)));
+    }
+    KDColor c = (h >> 20) % 5 == 0 ? rgb(0xFFE7B0) : rgb(0xFFFFFF);
+    fill(b, {x, y, 1, 1}, c, a);
+    if ((h >> 24) % 7 == 0) {
+      fill(b, {x - 1, y, 3, 1}, c, a / 3);
+      fill(b, {x, y - 1, 1, 3}, c, a / 3);
+    }
+  }
+}
+
+void drawSky(Band& b) {
+  const BiomeInfo& bi = biome();
+  const Rect& clip = b.clip();
+  KDColor far = rgb(bi.far), nearC = rgb(bi.nearLayer);
+  for (int y = clip.y; y < clip.bottom() && y < k_floorY; y++) {
+    KDColor* row = b.row(y);
+    KDColor sky = s_sky[y];
+    KDColor farShade = mix(far, s_sky[y], 40);
+    for (int x = clip.x; x < clip.right(); x++) {
+      if (y >= s_near[x]) {
+        row[x] = mix(nearC, rgb(0x000000), (y - s_near[x]) * 2);
+      } else if (y >= s_far[x]) {
+        row[x] = farShade;
+      } else {
+        row[x] = sky;
+      }
+    }
+  }
+  float cx = camX();
+  switch (s.biome) {
+    case Biome::Garden: {
+      ellipse(b, 262 - cx * 0.05f, 46, 22, 22, rgb(0xFFF4B0), 120);
+      ellipse(b, 262 - cx * 0.05f, 46, 16, 16, rgb(0xFFE45C));
+      for (int i = 0; i < 5; i++) {
+        float x = fmodf(i * 211.f - cx * 0.15f + s.now * 0.004f + 2000.f,
+                        700.f) - 80;
+        float y = 30 + (i * 37) % 70;
+        ellipse(b, x, y, 26, 9, rgb(0xFFFFFF), 220);
+        ellipse(b, x - 12, y - 5, 12, 9, rgb(0xFFFFFF), 220);
+        ellipse(b, x + 10, y - 7, 14, 10, rgb(0xFFFFFF), 220);
+      }
+      break;
+    }
+    case Biome::Night:
+      drawStars(b, 90, 0.1f, true);
+      ellipse(b, 70 - cx * 0.04f, 44, 24, 24, rgb(0xFFF6D8), 50);
+      ellipse(b, 70 - cx * 0.04f, 44, 15, 15, rgb(0xFFF6D8));
+      ellipse(b, 65 - cx * 0.04f, 40, 4, 4, rgb(0xE3DCC0));
+      ellipse(b, 75 - cx * 0.04f, 50, 3, 3, rgb(0xE3DCC0));
+      break;
+    case Biome::Volcano: {
+      // Glowing craters and their smoke
+      for (int k = -1; k < 4; k++) {
+        float base = floorf((cx * 0.3f) / 280.f) * 280.f + k * 280.f + 140.f;
+        float x = base - cx * 0.3f;
+        ellipse(b, x, 118, 30, 14, rgb(0xFF8A2E), 70);
+        ellipse(b, x, 116, 14, 5, rgb(0xFFD25C), 200);
+        for (int j = 0; j < 3; j++) {
+          float t = fmodf(s.now * 0.02f + j * 33.f, 100.f);
+          ellipse(b, x + sinf(t * 0.05f + j) * 8, 108 - t, 8 + t * 0.15f,
+                  6 + t * 0.12f, rgb(0x3A2020), 160 - static_cast<int>(t));
+        }
+      }
+      break;
+    }
+    case Biome::Space: {
+      drawStars(b, 140, 0.08f, false);
+      float px = 230 - cx * 0.06f;
+      ellipse(b, px, 70, 30, 30, rgb(0xE2894A));
+      ellipse(b, px - 6, 62, 22, 8, rgb(0xF0A868), 160);
+      ellipse(b, px + 4, 80, 24, 5, rgb(0xB8603A), 160);
+      for (int i = 0; i < 40; i++) {
+        float a = i * 2 * k_pi / 40;
+        float rx = 52 * cosf(a), ry = 11 * sinf(a) - rx * 0.12f;
+        if (sinf(a) < 0 && rx * rx + ry * ry < 900 && fabsf(rx) < 30) {
+          continue;  // behind the planet
+        }
+        ellipse(b, px + rx, 70 + ry, 2.2f, 1.6f, rgb(0xF3D9A6), 220);
+      }
+      // A comet
+      float t = fmodf(s.now * 0.05f, 900.f);
+      line(b, t - 100, 20 + t * 0.12f, t - 130, 16 + t * 0.12f, 2,
+           rgb(0xBFE6FF), 160);
+      break;
+    }
+    case Biome::Aquarium:
+      for (int i = 0; i < 5; i++) {
+        float x = 40 + i * 70 - fmodf(cx * 0.2f, 70.f) + sinf(s.now * 0.001f + i) * 6;
+        float pts[8] = {x, x + 22, x + 72, x + 40};
+        float ys[4] = {0, 0, static_cast<float>(k_floorY), k_floorY};
+        polygon(b, pts, ys, 4, rgb(0xBFEFFF), 22);
+      }
+      break;
+    case Biome::Disco: {
+      drawStars(b, 30, 0.1f, true);
+      float bx = 160, by = 26;
+      for (int i = 0; i < 6; i++) {
+        float a = s.now * 0.0012f + i * k_pi / 3;
+        float ex = bx + cosf(a) * 260, ey = by + 220;
+        float xs[3] = {bx, ex - 20, ex + 20};
+        float ys[3] = {by, ey, ey};
+        polygon(b, xs, ys, 3, hsv(i * 60 + s.now / 20, 200, 255), 40);
+      }
+      line(b, bx, 0, bx, by - 12, 1, rgb(0x888888));
+      ellipse(b, bx, by, 13, 13, rgb(0xC9CCD6));
+      for (int y = -12; y <= 12; y += 4) {
+        for (int x = -12; x <= 12; x += 4) {
+          if (x * x + y * y < 140 && hash(x * 31 + y + s.now / 150) % 3 == 0) {
+            fill(b, {static_cast<int>(bx) + x, static_cast<int>(by) + y, 2, 2},
+                 rgb(0xFFFFFF));
+          }
+        }
+      }
+      break;
+    }
+    default:
+      break;
+  }
+}
+
+void drawGround(Band& b) {
+  const BiomeInfo& bi = biome();
+  const Rect& clip = b.clip();
+  int floor = static_cast<int>(k_floorY) - s_shakeY;
+  if (clip.bottom() <= floor) {
+    return;
+  }
+  KDColor ground = rgb(bi.ground), edge = rgb(bi.edge);
+  KDColor dark = mix(ground, rgb(0x000000), 70);
+  int cx = static_cast<int>(camX());
+  for (int y = clip.y > floor ? clip.y : floor; y < clip.bottom(); y++) {
+    KDColor* row = b.row(y);
+    int d = y - floor;
+    for (int x = clip.x; x < clip.right(); x++) {
+      int wx = x + cx;
+      KDColor c;
+      if (s.biome == Biome::Disco) {
+        int tile = ((wx + 4000) / 26) + (d / 9) * 7;
+        int on = (hash(tile + (s.now / 460) * 131) % 3) == 0;
+        c = on ? hsv((tile * 47 + s.now / 30) % 360, 200, 230)
+               : rgb(0x1E0C30);
+        if ((wx + 4000) % 26 == 0 || d % 9 == 0) {
+          c = rgb(0x0A0412);
+        }
+      } else if (d < 3) {
+        c = edge;
+      } else {
+        c = mix(ground, dark, d * 6);
+        uint32_t h = hash(((wx + 4000) >> 2) * 73856093u ^ ((d >> 2) * 19349663u));
+        if ((h & 7) == 0) {
+          c = mix(c, dark, 160);
+        } else if ((h & 31) == 1) {
+          c = mix(c, edge, 90);
+        }
+        if (s.biome == Biome::Volcano && (h % 23) == 0) {
+          int glow = static_cast<int>(160 + 90 * sinf(s.now * 0.004f + (h & 63)));
+          c = mix(rgb(0xFF4A12), rgb(0xFFD040), glow - 100);
+        }
+      }
+      row[x] = c;
+    }
+  }
+}
+
+void drawDecor(Band& b) {
+  // Things on the ground, every 46 px (hashed)
+  float cx = camX();
+  int first = static_cast<int>(cx / 46) - 1;
+  for (int k = first; k < first + 9; k++) {
+    uint32_t h = hash(k * 2654435761u + static_cast<int>(s.biome));
+    float x = k * 46.f + (h % 30) - cx;
+    float y = k_floorY - s_shakeY;
+    switch (s.biome) {
+      case Biome::Garden:
+        if (h % 3 != 0) {
+          KDColor petal = hsv((h >> 8) % 360, 150, 255);
+          line(b, x, y, x + 1, y - 10, 1.5f, rgb(0x2F7D32));
+          for (int p = 0; p < 5; p++) {
+            float a = p * 2 * k_pi / 5;
+            ellipse(b, x + 1 + cosf(a) * 3, y - 11 + sinf(a) * 3, 2.4f, 2.4f, petal);
+          }
+          ellipse(b, x + 1, y - 11, 1.8f, 1.8f, rgb(0xFFE14A));
+        }
+        break;
+      case Biome::Night:
+        if (h % 3 == 0) {
+          float glow = 0.6f + 0.4f * sinf(s.now * 0.002f + (h & 15));
+          ellipse(b, x, y - 8, 12, 9, rgb(0x5CF2FF), static_cast<int>(50 * glow));
+          fill(b, {static_cast<int>(x) - 1, static_cast<int>(y) - 7, 3, 7}, rgb(0xD8F6FF));
+          ellipse(b, x, y - 8, 7, 4, rgb(0x34D6F0));
+          ellipse(b, x - 2, y - 9, 1.5f, 1, rgb(0xFFFFFF));
+        }
+        break;
+      case Biome::Volcano:
+        if (h % 4 == 0) {
+          float xs[3] = {x - 6, x + 6, x + 1};
+          float ys[3] = {y, y, y - 14 - static_cast<float>(h % 8)};
+          polygon(b, xs, ys, 3, rgb(0x3B1A14));
+        }
+        break;
+      case Biome::Space:
+        if (h % 2 == 0) {
+          float r = 5 + (h >> 4) % 9;
+          ellipse(b, x, y + 8 + (h >> 9) % 14, r, r * 0.35f, rgb(0x6C6C7A));
+          ellipse(b, x, y + 7 + (h >> 9) % 14, r * 0.8f, r * 0.22f, rgb(0x5A5A66));
+        }
+        break;
+      case Biome::Aquarium:
+        if (h % 2 == 0) {
+          float hgt = 26 + (h >> 5) % 40;
+          for (int sgm = 0; sgm < 6; sgm++) {
+            float t0 = sgm / 6.f, t1 = (sgm + 1) / 6.f;
+            float sw = sinf(s.now * 0.002f + k) * 7;
+            line(b, x + sw * t0 * t0, y - hgt * t0, x + sw * t1 * t1,
+                 y - hgt * t1, 3.f - 2 * t0, rgb(0x2E9A5A));
+          }
+        }
+        break;
+      default:
+        break;
+    }
+  }
+}
+
+void drawSign(Band& b, float wx, const char* label) {
+  float x = wx - camX(), y = k_floorY - s_shakeY;
+  if (x < -60 || x > k_screenWidth + 60) {
+    return;
+  }
+  fill(b, {static_cast<int>(x) - 2, static_cast<int>(y) - 34, 4, 34}, rgb(0x6B4423));
+  int w = textWidth(label) + 12;
+  Rect r = {static_cast<int>(x) - w / 2, static_cast<int>(y) - 52, w, 20};
+  roundFill(b, r, 4, rgb(0x8A5A2B));
+  roundFrame(b, r, 4, rgb(0x4A2E14));
+  text(b, label, static_cast<int>(x), r.y + 3, rgb(0xFFF2D6), Small, Align::Center);
+}
+
+void drawPlatforms(Band& b) {
+  const BiomeInfo& bi = biome();
+  for (int i = 0; i < s_numberOfPlatforms; i++) {
+    const Platform& p = s_platforms[i];
+    int x = p.x - static_cast<int>(camX()), y = p.y + s_shakeY * -1;
+    if (x > k_screenWidth || x + p.w < 0) {
+      continue;
+    }
+    KDColor top = rgb(bi.edge);
+    KDColor body = mix(rgb(bi.ground), rgb(0xFFFFFF), 30);
+    if (s.biome == Biome::Garden || s.biome == Biome::Night) {
+      // A mushroom
+      fill(b, {x + p.w / 2 - 5, y + 6, 10, static_cast<int>(k_floorY) - y - 6},
+           rgb(0xF2E6CF));
+      roundFill(b, {x, y, p.w, 11}, 5,
+                s.biome == Biome::Night ? rgb(0x7A4CFF) : rgb(0xE8443A));
+      for (int d = 0; d < 3; d++) {
+        ellipse(b, x + 10 + d * 20, y + 4, 3, 2, rgb(0xFFFFFF));
+      }
+    } else {
+      roundFill(b, {x, y, p.w, 9}, 4, body);
+      fill(b, {x + 2, y, p.w - 4, 2}, top);
+      roundFrame(b, {x, y, p.w, 9}, 4, mix(body, rgb(0x000000), 120));
+    }
+  }
+}
+
+void drawCandy(Band& b, float x, float y, int i, float scale, int alpha,
+               bool highlight) {
+  if (isGame(i)) {
+    int sz = static_cast<int>(30 * scale);
+    Rect box = {static_cast<int>(x) - sz / 2, static_cast<int>(y) - sz / 2, sz, sz};
+    roundFill(b, box, 5, rgb(0xE8463C), alpha);
+    if (alpha >= 256 && scale > 0.6f) {
+      Ion::ExternalApps::App app =
+          AppsContainer::sharedAppsContainer()->externalAppAtIndex(
+              s_items[i].item.index);
+      int icon = sz - 8;
+      gameIcon(b, app, box.x + 4, box.y + 4, icon);
+    }
+    roundFrame(b, box, 5, rgb(0xFFD23C), alpha);
+    ellipse(b, x - 6 * scale, box.y - 2, 6 * scale, 4 * scale, rgb(0xFFD23C), alpha);
+    ellipse(b, x + 6 * scale, box.y - 2, 6 * scale, 4 * scale, rgb(0xFFD23C), alpha);
+    ellipse(b, x, box.y - 1, 2.5f * scale, 2.5f * scale, rgb(0xE0A800), alpha);
+  } else {
+    KDColor c = itemColor(i);
+    KDColor wrap = mix(c, rgb(0xFFFFFF), 90);
+    KDColor dark = mix(c, rgb(0x0B0B1A), 150);
+    float r = 14 * scale;
+    for (int side = -1; side <= 1; side += 2) {
+      float xs[3] = {x + side * (r - 3), x + side * (r + 10 * scale),
+                     x + side * (r + 10 * scale)};
+      float ys[3] = {y, y - 9 * scale, y + 9 * scale};
+      float xo[3] = {xs[0], xs[1] + side, xs[2] + side};
+      float yo[3] = {ys[0], ys[1] - 1.5f, ys[2] + 1.5f};
+      polygon(b, xo, yo, 3, dark, alpha);
+      polygon(b, xs, ys, 3, wrap, alpha);
+    }
+    ellipse(b, x, y, r + 1.6f, r + 1.6f, dark, alpha);
+    ellipse(b, x, y, r, r, c, alpha);
+    // A swirl of light
+    arc(b, x, y, r * 0.62f, 2.f * scale, 2, mix(c, rgb(0xFFFFFF), 70), alpha / 2);
+    ellipse(b, x - r * 0.38f, y - r * 0.42f, r * 0.34f, r * 0.2f, rgb(0xFFFFFF),
+            alpha * 3 / 5);
+    if (scale > 0.7f && alpha >= 200) {
+      char sym[8];
+      itemSymbol(i, sym);
+      int ty = static_cast<int>(y) - glyphHeight() / 2;
+      KDColor ink = rgb(0x1A1030);
+      text(b, sym, static_cast<int>(x) + 1, ty + 1, ink, Small, Align::Center,
+           k_screenWidth, 160);
+      text(b, sym, static_cast<int>(x), ty, rgb(0xFFFFFF), Small, Align::Center);
+    }
+  }
+  if (highlight) {
+    float pulse = 3 + 2 * sinf(s.now * 0.012f);
+    arc(b, x, y, 19 * scale + pulse, 2, 0, rgb(0xFFFFFF), 200);
+  }
+}
+
+void drawPellet(Band& b, float x, float y, const char* t, int alpha,
+                bool highlight) {
+  int w = textWidth(t) + 10;
+  Rect r = {static_cast<int>(x) - w / 2, static_cast<int>(y) - 9, w, 18};
+  roundFill(b, {r.x + 1, r.y + 2, r.w, r.h}, 7, rgb(0x000000), alpha / 4);
