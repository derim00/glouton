+constexpr int k_fridgeColumns = 4;
+constexpr int k_fridgeRows = 3;
+
+void drawFridge(Band& b) {
+  KDColor ink = rgb(0x1A1030);
+  // Inside: cold light
+  const Rect& clip = b.clip();
+  for (int y = clip.y; y < clip.bottom(); y++) {
+    KDColor c = mix(rgb(0xF4FBFF), rgb(0xCFE6F5), y * 256 / k_screenHeight);
+    fill(b, {0, y, k_screenWidth, 1}, c);
+  }
+  fill(b, {0, 0, k_screenWidth, 36}, rgb(0xFFFFFF));
+  fill(b, {0, 36, k_screenWidth, 2}, rgb(0x9FC3DA));
+  text(b, "LE FRIGO DE GLOUTON", 12, 4, ink, Large);
+  text(b, "Choisis ce qu'il mange.", 12, 20, rgb(0x6A7A90), Small);
+  int page = s.menuSelected / (k_fridgeColumns * k_fridgeRows);
+  int first = page * k_fridgeColumns * k_fridgeRows;
+  for (int row = 0; row < k_fridgeRows; row++) {
+    int shelfY = 40 + row * 60 + 56;
+    // Glass shelf
+    fill(b, {6, shelfY, k_screenWidth - 12, 3}, rgb(0xFFFFFF), 200);
+    fill(b, {6, shelfY + 3, k_screenWidth - 12, 1}, rgb(0x8FB4CC), 200);
+    for (int col = 0; col < k_fridgeColumns; col++) {
+      int i = first + row * k_fridgeColumns + col;
+      if (i >= s_numberOfItems) {
+        continue;
+      }
+      int cx = 40 + col * 80, cy = 40 + row * 60;
+      bool sel = i == s.menuSelected;
+      if (sel) {
+        roundFill(b, {cx - 37, cy, 74, 55}, 8, rgb(0xFFF1A8));
+        roundFrame(b, {cx - 37, cy, 74, 55}, 8, rgb(0xE0A800));
+      }
+      float bob = sel ? 2 * sinf(s.now * 0.01f) : 0;
+      drawCandy(b, cx, cy + 20 + bob, i, sel ? 1.05f : 0.95f, 256, false);
+      text(b, itemName(i), cx, cy + 38, ink, Small, Align::Center, 78);
+    }
+  }
+  int pages = (s_numberOfItems + k_fridgeColumns * k_fridgeRows - 1) /
+              (k_fridgeColumns * k_fridgeRows);
+  fill(b, {0, 222, k_screenWidth, 18}, rgb(0xFFFFFF));
+  text(b, "OK : il le mange   Retour : fermer", k_screenWidth / 2, 224,
+       rgb(0x6A7A90), Small, Align::Center);
+  if (pages > 1) {
+    char p[8];
+    Str ps(p, sizeof(p));
+    ps.addInt(page + 1).add("/").addInt(pages);
+    text(b, p, k_screenWidth - 8, 20 - 1, rgb(0x6A7A90), Small, Align::Right);
+  }
+  // The door swings open
+  uint32_t t = s.now - s.modeStart;
+  if (t < 260) {
+    float k = 1 - t / 260.f;
+    k = k * k;
+    int w = static_cast<int>(k_screenWidth * k);
+    fill(b, {0, 0, w, k_screenHeight}, rgb(0xF2F4F7));
+    fill(b, {w - 3, 0, 3, k_screenHeight}, rgb(0xB8C2CC));
+    if (w > 30) {
+      roundFill(b, {w - 22, 80, 8, 70}, 4, rgb(0xB8C2CC));
+    }
+  }
+}
