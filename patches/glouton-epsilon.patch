+void say(const char* text, Face face = Face::Happy, int duration = 3200) {
+  Message m;
+  strlcpy(m.text, text, sizeof(m.text));
+  m.face = face;
+  m.duration = duration;
+  showMessage(m);
+  s.queueLength = 0;
+}
+
+void queue(const char* text, Face face = Face::Happy, int duration = 3200) {
+  if (s.message.text[0] == 0) {
+    say(text, face, duration);
+    return;
+  }
+  if (s.queueLength < count(s.queue)) {
+    Message& m = s.queue[s.queueLength++];
+    strlcpy(m.text, text, sizeof(m.text));
+    m.face = face;
+    m.duration = duration;
+  }
+}
+
+void updateMessages() {
+  if (s.message.text[0] && s.now - s.messageStart > s.message.duration) {
+    s.message.text[0] = 0;
+    if (s.queueLength > 0) {
+      showMessage(s.queue[0]);
+      for (int i = 1; i < s.queueLength; i++) {
+        s.queue[i - 1] = s.queue[i];
+      }
+      s.queueLength--;
+    }
+  }
