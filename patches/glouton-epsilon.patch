@@ -0,0 +1,314 @@
+#include "blob.h"
+
+#include <math.h>
+
+namespace Home {
+namespace Glouton {
+
+namespace {
+constexpr float k_twoPi = 6.2831853f;
+constexpr int k_substeps = 4;
+constexpr float k_internalDamping = 7.f;  // 1/s, damps the wobble only
+constexpr float k_maxSpeed = 210.f;       // px/s, horizontal
+}  // namespace
+
+void Blob::init(float x, float y, float radius) {
+  m_radius = m_targetRadius = radius;
+  m_inflation = 1.f;
+  m_stiffness = 520.f;
+  for (int i = 0; i < k_points; i++) {
+    float a = k_twoPi * i / k_points;
+    m_restX[i] = cosf(a);
+    m_restY[i] = sinf(a);
+    m_px[i] = x + m_restX[i] * radius;
+    m_py[i] = y + m_restY[i] * radius;
+    m_vx[i] = m_vy[i] = 0;
+  }
+  m_groundTime = 1.f;
+  m_impact = 0;
+  updateShape();
+}
+
+void Blob::updateShape() {
+  float sx = 0, sy = 0, svx = 0, svy = 0;
+  float minX = 1e9f, maxX = -1e9f, minY = 1e9f, maxY = -1e9f;
+  for (int i = 0; i < k_points; i++) {
+    sx += m_px[i];
+    sy += m_py[i];
+    svx += m_vx[i];
+    svy += m_vy[i];
+    minX = m_px[i] < minX ? m_px[i] : minX;
+    maxX = m_px[i] > maxX ? m_px[i] : maxX;
+    minY = m_py[i] < minY ? m_py[i] : minY;
+    maxY = m_py[i] > maxY ? m_py[i] : maxY;
+  }
+  m_cx = sx / k_points;
+  m_cy = sy / k_points;
+  m_mvx = svx / k_points;
+  m_mvy = svy / k_points;
+  m_hw = (maxX - minX) * 0.5f;
+  m_hh = (maxY - minY) * 0.5f;
+  m_minY = minY;
+  m_maxY = maxY;
+}
+
+void Blob::moveTo(float x, float y) {
+  float dx = x - m_cx, dy = y - m_cy;
+  for (int i = 0; i < k_points; i++) {
+    m_px[i] += dx;
+    m_py[i] += dy;
+  }
+  updateShape();
+}
+
+void Blob::impulse(float vx, float vy) {
+  for (int i = 0; i < k_points; i++) {
+    m_vx[i] += vx;
+    m_vy[i] += vy;
+  }
+  updateShape();
+}
+
+void Blob::jiggle(float strength, uint32_t seed) {
+  for (int i = 0; i < k_points; i++) {
+    seed = seed * 1664525u + 1013904223u;
+    float r = ((seed >> 8) & 0xFFFF) / 65535.f - 0.5f;
+    m_vx[i] += m_restX[i] * strength * r * 2.f;
+    m_vy[i] += m_restY[i] * strength * r * 2.f;
+  }
+}
+
+void Blob::squeeze(float amount) {
+  for (int i = 0; i < k_points; i++) {
+    float dx = m_px[i] - m_cx, dy = m_py[i] - m_cy;
+    m_vx[i] += dx * amount;
+    m_vy[i] -= dy * amount;
+  }
+}
+
+void Blob::step(float dt, const Env& env, const Control& c) {
+  if (dt <= 0) {
+    return;
+  }
+  // The radius grows (or shrinks) smoothly
+  m_radius += (m_targetRadius - m_radius) * (dt * 3.f > 1.f ? 1.f : dt * 3.f);
+  float down = env.gravity >= 0 ? 1.f : -1.f;
+  float g = fabsf(env.gravity);
+  float h = dt / k_substeps;
+  bool groundedNow = grounded();
+  if (c.jump && groundedNow) {
+    float v = sqrtf(2.f * g * env.jumpHeight);
+    for (int i = 0; i < k_points; i++) {
+      m_vy[i] = -down * v;
+    }
+    m_groundTime = 1.f;
+    // Stretch: the top leaves first
+    squeeze(-2.5f);
+  }
+  if (c.slam && !groundedNow) {
+    for (int i = 0; i < k_points; i++) {
+      m_vy[i] = down * 620.f;
+    }
+  }
+  float scale = m_radius * m_inflation;
+  float accel = groundedNow ? 900.f : 520.f;
+  for (int s = 0; s < k_substeps; s++) {
+    updateShape();
+    // Best rotation of the rest shape (2D shape matching)
+    float num = 0, den = 0;
+    for (int i = 0; i < k_points; i++) {
+      float qx = m_px[i] - m_cx, qy = m_py[i] - m_cy;
+      num += m_restX[i] * qy - m_restY[i] * qx;
+      den += m_restX[i] * qx + m_restY[i] * qy;
+    }
+    float len = sqrtf(num * num + den * den);
+    float cs = len > 1e-4f ? den / len : 1.f;
+    float sn = len > 1e-4f ? num / len : 0.f;
+    // Rising: more gravity when the jump key is released (short hops)
+    float gravity = g;
+    bool rising = m_mvy * down < 0;
+    if (rising && !c.jumpHeld) {
+      gravity *= 2.2f;
+    }
+    float damp = 1.f - env.drag * h;
+    float internal = k_internalDamping * h;
+    for (int i = 0; i < k_points; i++) {
+      float tx = m_cx + (cs * m_restX[i] - sn * m_restY[i]) * scale;
+      float ty = m_cy + (sn * m_restX[i] + cs * m_restY[i]) * scale;
+      m_vx[i] += (tx - m_px[i]) * m_stiffness * h;
+      m_vy[i] += (ty - m_py[i]) * m_stiffness * h;
+      m_vx[i] += (m_mvx - m_vx[i]) * internal;
+      m_vy[i] += (m_mvy - m_vy[i]) * internal;
+      m_vy[i] += down * gravity * h;
+      m_vx[i] += c.move * accel * h;
+      m_vx[i] *= damp;
+      m_vy[i] *= damp;
+    }
+    // Top speed
+    float svx = 0;
+    for (int i = 0; i < k_points; i++) {
+      svx += m_vx[i];
+    }
+    svx /= k_points;
+    float excess = 0;
+    if (svx > k_maxSpeed) {
+      excess = svx - k_maxSpeed;
+    } else if (svx < -k_maxSpeed) {
+      excess = svx + k_maxSpeed;
+    }
+    bool touched = false;
+    for (int i = 0; i < k_points; i++) {
+      m_vx[i] -= excess;
+      float oy = m_py[i];
+      m_px[i] += m_vx[i] * h;
+      m_py[i] += m_vy[i] * h;
+      bool contact = false;
+      float hit = 0;
+      // Floor and ceiling
+      if (m_py[i] > env.floorY) {
+        m_py[i] = env.floorY;
+        if (m_vy[i] > 0) {
+          hit = m_vy[i];
+          m_vy[i] = -m_vy[i] * env.bounce;
+        }
+        contact = down > 0;
+      } else if (m_py[i] < env.ceilY) {
+        m_py[i] = env.ceilY;
+        if (m_vy[i] < 0) {
+          hit = -m_vy[i];
+          m_vy[i] = -m_vy[i] * env.bounce;
+        }
+        contact = down < 0;
+      }
+      // One-way platforms, in the direction of gravity
+      for (int p = 0; p < env.numberOfPlatforms && !contact; p++) {
+        const Platform& pl = env.platforms[p];
+        if (m_px[i] < pl.x || m_px[i] > pl.x + pl.w) {
+          continue;
+        }
+        if (down > 0 && oy <= pl.y + 0.5f && m_py[i] > pl.y) {
+          m_py[i] = pl.y;
+          if (m_vy[i] > 0) {
+            hit = m_vy[i];
+            m_vy[i] = -m_vy[i] * env.bounce;
+          }
+          contact = true;
+        } else if (down < 0 && oy >= pl.y + 8.5f && m_py[i] < pl.y + 8) {
+          m_py[i] = pl.y + 8;
+          if (m_vy[i] < 0) {
+            hit = -m_vy[i];
+            m_vy[i] = -m_vy[i] * env.bounce;
+          }
+          contact = true;
+        }
+      }
+      if (contact) {
+        touched = true;
+        // Friction: sticky when not moving on purpose
+        float f = (c.move != 0 ? 2.f : 9.f) * h;
+        m_vx[i] -= m_vx[i] * (f > 1 ? 1 : f);
+        if (hit > m_impact) {
+          m_impact = hit;
+        }
+      }
+      // Walls
+      if (m_px[i] < env.left) {
+        m_px[i] = env.left;
+        m_vx[i] = m_vx[i] < 0 ? -m_vx[i] * 0.4f : m_vx[i];
+      } else if (m_px[i] > env.right) {
+        m_px[i] = env.right;
+        m_vx[i] = m_vx[i] > 0 ? -m_vx[i] * 0.4f : m_vx[i];
+      }
+    }
+    if (touched) {
+      m_groundTime = 0;
+    } else {
+      m_groundTime += h;
+    }
+  }
+  updateShape();
+}
+
+void Blob::render(Band& b, float camX, float camY, KDColor color, int alpha,
+                  bool glow) const {
+  // Smooth outline (Catmull-Rom, one extra point per edge), screen space
+  float sx[k_smooth], sy[k_smooth];
+  float minX = 1e9f, maxX = -1e9f, minY = 1e9f, maxY = -1e9f;
+  for (int i = 0; i < k_points; i++) {
+    int i0 = (i + k_points - 1) % k_points, i2 = (i + 1) % k_points,
+        i3 = (i + 2) % k_points;
+    float x1 = m_px[i] - camX, y1 = m_py[i] - camY;
+    float x2 = m_px[i2] - camX, y2 = m_py[i2] - camY;
+    sx[2 * i] = x1;
+    sy[2 * i] = y1;
+    sx[2 * i + 1] = (-(m_px[i0] - camX) + 9 * x1 + 9 * x2 - (m_px[i3] - camX)) / 16.f;
+    sy[2 * i + 1] = (-(m_py[i0] - camY) + 9 * y1 + 9 * y2 - (m_py[i3] - camY)) / 16.f;
+  }
+  for (int i = 0; i < k_smooth; i++) {
+    minX = sx[i] < minX ? sx[i] : minX;
+    maxX = sx[i] > maxX ? sx[i] : maxX;
+    minY = sy[i] < minY ? sy[i] : minY;
+    maxY = sy[i] > maxY ? sy[i] : maxY;
+  }
+  Rect box = {static_cast<int>(minX) - 3, static_cast<int>(minY) - 3,
+              static_cast<int>(maxX - minX) + 7,
+              static_cast<int>(maxY - minY) + 7};
+  Rect z = box.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  float cx = m_cx - camX, cy = m_cy - camY;
+  // Outline: the same shape pushed out by 1.7 px
+  float ox[k_smooth], oy[k_smooth];
+  for (int i = 0; i < k_smooth; i++) {
+    float dx = sx[i] - cx, dy = sy[i] - cy;
+    float d = sqrtf(dx * dx + dy * dy);
+    float k = d > 0.5f ? (d + 1.7f) / d : 1.f;
+    ox[i] = cx + dx * k;
+    oy[i] = cy + dy * k;
+  }
+  KDColor outline = glow ? mix(color, rgb(0xFFFFFF), 120)
+                         : mix(color, rgb(0x0B0B1A), 190);
+  KDColor light = mix(color, rgb(0xFFFFFF), glow ? 140 : 90);
+  KDColor dark = mix(color, rgb(0x0B0B1A), glow ? 40 : 120);
+  float ihw = 1.f / (m_hw > 1 ? m_hw : 1), ihh = 1.f / (m_hh > 1 ? m_hh : 1);
+  float crossings[16];
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    float fy = y + 0.5f;
+    int k = polygonCrossings(ox, oy, k_smooth, fy, crossings, 16);
+    for (int i = 0; i < k; i += 2) {
+      int x0 = static_cast<int>(crossings[i] + 0.5f);
+      int x1 = static_cast<int>(crossings[i + 1] + 0.5f);
+      x0 = x0 < z.x ? z.x : x0;
+      x1 = x1 > z.right() ? z.right() : x1;
+      for (int x = x0; x < x1; x++) {
+        blendPixel(row + x, outline, alpha);
+      }
+    }
+    k = polygonCrossings(sx, sy, k_smooth, fy, crossings, 16);
+    float ny = (fy - cy) * ihh;
+    for (int i = 0; i < k; i += 2) {
+      int x0 = static_cast<int>(crossings[i] + 0.5f);
+      int x1 = static_cast<int>(crossings[i + 1] + 0.5f);
+      x0 = x0 < z.x ? z.x : x0;
+      x1 = x1 > z.right() ? z.right() : x1;
+      for (int x = x0; x < x1; x++) {
+        float nx = (x + 0.5f - cx) * ihw;
+        // Lit from the top left, darker at the bottom right and on the rim
+        float t = 0.42f + 0.22f * nx + 0.38f * ny;
+        float r2 = nx * nx + ny * ny;
+        if (r2 > 0.62f) {
+          t += (r2 - 0.62f) * 0.9f;
+        }
+        int ti = static_cast<int>(t * 256);
+        KDColor c = ti < 128 ? mix(light, color, ti * 2)
+                             : mix(color, dark, (ti - 128) * 2);
+        blendPixel(row + x, c, alpha);
+      }
+    }
+  }
+}
+
+}  // namespace Glouton
+}  // namespace Home
diff --git a/epsilon/apps/home/glouton/blob.h b/epsilon/apps/home/glouton/blob.h
new file mode 100644
index 0000000000..0dafad988c
--- /dev/null
+++ b/epsilon/apps/home/glouton/blob.h
@@ -0,0 +1,93 @@
+#pragma once
+
+/* GLOUTON's body: a real soft body.
+ *
+ * A ring of points pulled back towards their rest shape (shape matching:
+ * the best rotation of the rest circle, scaled by the inflation), with
+ * gravity, drag and collisions. Landing squashes it, jumping stretches it,
+ * poking it makes it wobble: nothing is animated by hand. */
+
+#include <stdint.h>
+
+#include "gfx.h"
+
+namespace Home {
+namespace Glouton {
+
+struct Platform {
+  int16_t x, y, w;
+};
+
+struct Env {
+  float gravity;      // px/s^2, negative: upside down
+  float drag;         // 1/s
+  float jumpHeight;   // px
+  float floorY, ceilY, left, right;
+  float bounce;       // 0..1 on the floor
+  const Platform* platforms;
+  int numberOfPlatforms;
+};
+
+struct Control {
+  float move;     // -1..1
+  bool jump;      // starts a jump (if on the ground)
+  bool jumpHeld;  // longer jumps while held
+  bool slam;      // dives towards the ground
+};
+
+class Blob {
+ public:
+  constexpr static int k_points = 20;
+  constexpr static int k_smooth = 2 * k_points;
+
+  void init(float x, float y, float radius);
+  void setRadius(float r) { m_targetRadius = r; }
+  float radius() const { return m_radius; }
+  void setInflation(float s) { m_inflation = s; }
+  float inflation() const { return m_inflation; }
+  void setStiffness(float k) { m_stiffness = k; }
+  void step(float dt, const Env& env, const Control& c);
+  void impulse(float vx, float vy);
+  // Random wobble (a poke, a chew, a burp)
+  void jiggle(float strength, uint32_t seed);
+  // Squeezes horizontally (> 0) or vertically (< 0), keeps the momentum
+  void squeeze(float amount);
+  void moveTo(float x, float y);
+
+  float x() const { return m_cx; }
+  float y() const { return m_cy; }
+  float vx() const { return m_mvx; }
+  float vy() const { return m_mvy; }
+  // Half extents of the bounding box (squash and stretch)
+  float halfWidth() const { return m_hw; }
+  float halfHeight() const { return m_hh; }
+  float top() const { return m_minY; }
+  float bottom() const { return m_maxY; }
+  bool grounded() const { return m_groundTime < 0.12f; }
+  // Speed of the last impact on the ground, then 0
+  float takeImpact() {
+    float i = m_impact;
+    m_impact = 0;
+    return i;
+  }
+
+  /* Draws the body: dark outline, then a glossy translucent jelly. `glow`
+   * makes it emissive (night). */
+  void render(Band& b, float camX, float camY, KDColor color, int alpha,
+              bool glow) const;
+
+ private:
+  void updateShape();
+
+  float m_px[k_points], m_py[k_points];
+  float m_vx[k_points], m_vy[k_points];
+  float m_restX[k_points], m_restY[k_points];  // unit circle
+  float m_radius, m_targetRadius, m_inflation, m_stiffness;
+  float m_cx, m_cy, m_mvx, m_mvy;
+  float m_hw, m_hh, m_minY, m_maxY;
+  float m_groundTime;
+  float m_impact;
+};
+
+}  // namespace Glouton
+}  // namespace Home
diff --git a/epsilon/apps/home/glouton/food.cpp b/epsilon/apps/home/glouton/food.cpp
new file mode 100644
index 0000000000..cc283df42f
--- /dev/null
+++ b/epsilon/apps/home/glouton/food.cpp
@@ -0,0 +1,55 @@
+#include "food.h"
+
+#include <string.h>
+
+namespace Home {
+namespace Glouton {
+namespace Food {
+
+namespace {
+Entry s_ring[k_ringSize];
+uint32_t s_produced = 0;
+
+void copy(char* dst, const char* src) {
+  int n = 0;
+  if (src) {
+    while (src[n] && n < k_textSize - 1) {
+      dst[n] = src[n];
+      n++;
+    }
+    if (src[n] != 0) {
+      // Cut: never cut a UTF-8 character in two
+      while (n > 0 && (static_cast<uint8_t>(dst[n - 1]) & 0xC0) == 0x80) {
+        n--;
+      }
+      if (n > 0 && (static_cast<uint8_t>(dst[n - 1]) & 0xC0) == 0xC0) {
+        n--;
+      }
+    }
+  }
+  dst[n] = 0;
+}
+}  // namespace
+
+void push(const char* input, const char* output) {
+  if (output == nullptr || output[0] == 0) {
+    return;
+  }
+  Entry& e = s_ring[s_produced % k_ringSize];
+  copy(e.input, input);
+  copy(e.output, output);
+  s_produced++;
+}
+
+uint32_t produced() { return s_produced; }
+
+const Entry* at(uint32_t index) {
+  if (index >= s_produced || s_produced - index > k_ringSize) {
+    return nullptr;
+  }
+  return &s_ring[index % k_ringSize];
+}
+
+}  // namespace Food
+}  // namespace Glouton
+}  // namespace Home
