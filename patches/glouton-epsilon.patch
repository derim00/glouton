+/* ========================================================== the creature */
+
+const BiomeInfo& biome() { return k_biomes[static_cast<int>(s.biome)]; }
+
+int stageFor(int xp) {
+  int st = 0;
+  for (int i = 0; i < k_numberOfStages; i++) {
+    if (xp >= k_stageXp[i]) {
+      st = i;
+    }
+  }
+  return st;
+}
+
+KDColor baseColor() {
+  if (s.now < s.evilUntil) {
+    return rgb(0xD3243A);
+  }
+  if (s.now < s.sickUntil) {
+    return rgb(0xA8B83A);
+  }
+  if (s.biome == Biome::Disco) {
+    return hsv((s.now / 12) % 360, 170, 250);
+  }
+  if (s.now < s.danceUntil) {
+    return hsv((s.now / 8) % 360, 160, 250);
+  }
+  KDColor c = rgb(0x67DD5C);
+  if (s.stage == 3) {
+    // The supreme glutton shimmers
+    c = mix(c, rgb(0x46E0B4), static_cast<int>(128 + 120 * sinf(s.now * 0.002f)));
+  }
+  if (s.now < s.tintUntil) {
+    int left = static_cast<int>(s.tintUntil - s.now);
+    int t = left > 2000 ? 200 : left / 10;
+    c = mix(c, KDColor::RGB16(s.tint), t);
+  }
+  if (s.tanned) {
+    c = mix(c, rgb(0xA0662E), 130);
+  }
+  if (s.hunger > 75) {
+    c = mix(c, rgb(0x8C9A8A), static_cast<int>((s.hunger - 75) * 4));
+  }
+  return c;
+}
+
+Face currentFace() {
+  if (s.eat == EatPhase::Chew) {
+    return Face::Chew;
+  }
+  if (s.eat == EatPhase::TongueOut || s.eat == EatPhase::TongueBack ||
+      s.eat == EatPhase::Fly || s.eat == EatPhase::Burp) {
+    return Face::Wow;
+  }
+  if (s.now < s.faceUntil) {
+    return s.faceOverride;
+  }
+  if (s.sleeping) {
+    return Face::Sleep;
+  }
+  if (s.now < s.evilUntil) {
+    return Face::Evil;
+  }
+  if (s.now < s.angryUntil) {
+    return Face::Angry;
+  }
+  if (s.now < s.sickUntil) {
+    return Face::Sick;
+  }
+  if (s.now < s.partyUntil || s.now < s.danceUntil) {
+    return Face::Joy;
+  }
+  if (s.message.text[0] && s.message.face != Face::Happy) {
+    return s.message.face;
+  }
+  if (s.hunger > 75) {
+    return Face::Hungry;
+  }
+  return Face::Happy;
+}
