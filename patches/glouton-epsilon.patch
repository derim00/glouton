+void renderWorld(Band& b) {
+  drawSky(b);
+  drawGround(b);
+  drawDecor(b);
+  drawSign(b, 60, "GLOUTON");
+  if (s_numberOfItems > s_numberOfBuiltin) {
+    drawSign(b, s_items[s_numberOfBuiltin].x - 50, "JEUX");
+  }
+  drawPlatforms(b);
+  float cx = camX(), cy = camY();
+  for (int i = 0; i < s_numberOfItems; i++) {
+    if (i == s.goneItem) {
+      continue;
+    }
+    float x = s_items[i].x - cx;
+    if (x < -40 || x > k_screenWidth + 40) {
+      continue;
+    }
+    float y = s_items[i].y + itemBob(i) - cy;
+    // Shadow on the floor
+    ellipse(b, x, k_floorY - cy + 1, 11, 3, rgb(0x000000), 50);
+    drawCandy(b, x, y, i, 1.f, 256, s.targetKind == 1 && s.targetIndex == i &&
+                                        s.eat == EatPhase::None);
+  }
+  for (int i = 0; i < k_maxPellets; i++) {
+    const Pellet& p = s.pellets[i];
+    if (!p.active || (s.eat == EatPhase::TongueOut && s.meal == Meal::Pellet &&
+                      s.eatIndex == i && false)) {
+      continue;
+    }
+    drawPellet(b, p.x - cx, p.y - cy, p.text, 256,
+               s.targetKind == 2 && s.targetIndex == i && s.eat == EatPhase::None);
+  }
+  drawBlobAndCo(b);
+  drawParticles(b);
+  if (s.now < s.evilUntil) {
+    fill(b, b.clip(), rgb(0xFF0000), 40);
+  }
+  if (s.now < s.sickUntil) {
+    fill(b, b.clip(), rgb(0x7AFF3A), 22);
+  }
+  drawBubble(b);
+  drawHud(b);
+}
