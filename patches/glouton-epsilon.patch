+
+void digest() {
+  /* GLOUTON swallowed an app: the screen closes on its mouth, then the app
+   * opens (inside its belly, obviously). Drawn here: the app is opened right
+   * after. */
+  s.mode = Mode::Digest;
+  s.modeStart = s.now;
+  Band band;
+  while (!s_fake) {
+    s.now = clockMs();
+    if (s.now - s.modeStart > 900) {
+      break;
+    }
+    updateLed();
+    for (int y = 0; y < k_screenHeight; y += Band::k_maxHeight) {
+      Rect area = {0, y, k_screenWidth, Band::k_maxHeight};
+      band.begin(area);
+      Shell::render(band);
+      Ion::Display::pushRect(KDRect(area.x, area.y, area.w, area.h), band.pixels());
+    }
+  }
+  s.mode = Mode::World;
+  s.launches++;
+  s.lastLaunched = s.eatIndex;
+  s.detachTime = s.now;
+  s_launch = s_items[s.eatIndex].item;
+}
